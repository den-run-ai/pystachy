  "compaction": "Per-step phase timers omitted; all run phase totals, sample times, numerical comparisons, execution order and build commands retained.",
  "comparison_controller_source": "\"\"\"Bounded follow-up: interleave fresh microGPT AOT processes, verify all vectors.\"\"\"\nimport hashlib\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport platform\nimport statistics\nimport subprocess\n\nBASE = Path('/workspace/scratch/773660c98364')\nROOT = BASE / 'tuple-conversion'\nWORK = BASE / 'tuple-bench-alternating'\nspec = importlib.util.spec_from_file_location('bench_microgpt', ROOT / 'tools/bench_microgpt.py')\nb = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(b)\nWORK.mkdir(exist_ok=True)\n(WORK / 'input.txt').symlink_to(BASE / 'microgpt-names.txt')\nsource = b.instrument((ROOT / 'bench/microgpt/microgpt.py').read_text())\nprogram = WORK / 'adapted.py'\nprogram.write_text(source)\nreference = json.loads((BASE / 'tuple-microgpt-before-raw.json').read_text())['reference_checks']\nenv = os.environ.copy()\npython = '/root/.local/bin/python3.13'\nroots = {'before': BASE / 'tuple-base', 'after': ROOT}\nreport = {\n    'workload': 'microGPT alternating AOT comparison',\n    'purpose': 'Follow up exploratory non-interleaved reports after concurrent ownership-test contamination was reported.',\n    'method': 'Five paired fresh-process repetitions; alternate before/after ordering per pair; CPU affinity inherited from controller. Compile both executables before measured runs. No other coordinated native builds or tests during this comparison.',\n    'steps': 100, 'samples': 5, 'all_gradients': False, 'lr_schedule_steps': 1000,\n    'seed': 42, 'repeats_per_version': 5,\n    'platform': platform.platform(),\n    'cpu_affinity': sorted(os.sched_getaffinity(0)),\n    'controller_python': platform.python_version(),\n    'measurement_controller_sha256': hashlib.sha256((ROOT / 'tools/bench_microgpt.py').read_bytes()).hexdigest(),\n    'comparison_controller_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),\n    'adapted_instrumented_sha256': hashlib.sha256(source.encode()).hexdigest(),\n    'dataset_sha256': hashlib.sha256((BASE / 'microgpt-names.txt').read_bytes()).hexdigest(),\n    'reference_checks_sha256': b.digest(reference),\n    'compiler_git_revisions': {k: subprocess.check_output(['git', 'rev-parse', 'HEAD'],cwd=v,text=True).strip() for k,v in roots.items()},\n    'source_provenance_reports': {'before': 'direct-tuples-before-linux-x86_64-2026-11-07.json', 'after': 'direct-tuples-after-linux-x86_64-2026-11-07.json'},\n    'builds': {}, 'runs': [], 'errors': [],\n}\npath = BASE / 'tuple-microgpt-alternating-raw.json'\nfor name, root in roots.items():\n    exe = WORK / ('microgpt-' + name)\n    result = b.execute([python, str(root / 'pystachy.py'), 'build', str(program), '-o', str(exe)], root, env, 300)\n    report['builds'][name] = b.compact_result(result)\n    if not b.successful(result):\n        report['errors'].append(name + ' build failed')\n        b.save(report,path)\n        raise SystemExit(1)\n    report['builds'][name]['executable_sha256'] = hashlib.sha256(exe.read_bytes()).hexdigest()\n    print(name, 'build complete', flush=True)\nfor pair in range(5):\n    names = ['before', 'after'] if pair % 2 == 0 else ['after', 'before']\n    for name in names:\n        result = b.execute([str(WORK / ('microgpt-' + name)), '100', '5', '0'],WORK,env,300)\n        record = {'pair': pair, 'version': name, 'command': result['command'], 'wall_seconds': result['wall_seconds'], 'returncode': result['returncode'], 'timed_out': result['timed_out'], 'stderr': result['stderr'], 'peak_rss_kib': result['peak_rss_kib']}\n        if b.successful(result):\n            checks, timing = b.parse_output(result['stdout'],100,5,False)\n            record.update(timing=timing, checks_sha256=b.digest(checks), comparison=b.compare(checks,reference))\n        else:\n            record['stdout_tail'] = result['stdout'][-4000:]\n            report['errors'].append(name + ' execution failed')\n        report['runs'].append(record)\n        b.save(report,path)\n        print(pair, name, record.get('timing',{}).get('train_seconds'), 'verified' if 'comparison' in record else 'FAILED',flush=True)\nreport['medians'] = {}\nfor name in roots:\n    runs = [r for r in report['runs'] if r['version'] == name and 'comparison' in r]\n    report['medians'][name] = {k: statistics.median(r['timing'][k] for r in runs) for k in ('initialization_seconds','forward_seconds','backward_seconds','optimizer_seconds','train_seconds','inference_seconds')}\n    report['medians'][name]['wall_seconds'] = statistics.median(r['wall_seconds'] for r in runs)\nreport['all_verified'] = not report['errors'] and len(report['runs']) == 10\nb.save(report,path)\nprint('COMPLETE', report['all_verified'], json.dumps(report['medians']),flush=True)\n",

 "sources": {
  "saxpy": "import sys\nimport math\n\n\ndef fill(n: int, seed: int) -> list[float]:\n    out = [0.0] * n\n    x = seed\n    for i in range(n):\n        x = (x * 1103515245 + 12345) % 2147483648\n        out[i] = (x % 1000) / 250.0 + 0.5\n    return out\n\n\ndef ifill(n: int, seed: int) -> list[int]:\n    out = [0] * n\n    x = seed\n    for i in range(n):\n        x = (x * 1103515245 + 12345) % 2147483648\n        out[i] = x % 1000\n    return out\n\n\ndef kernel(a: float, x: list[float], y: list[float]) -> None:\n    for i in range(len(x)):\n        y[i] = a * x[i] + y[i]\n\n\ndef main() -> None:\n    n = int(sys.argv[1])\n    reps = int(sys.argv[2])\n    x = fill(n, 1)\n    y = fill(n, 2)\n    for r in range(reps):\n        kernel(0.5, x, y)\n    print(sum(y))\n\n\nmain()\n",
  "scale": "import sys\nimport math\n\n\ndef fill(n: int, seed: int) -> list[float]:\n    out = [0.0] * n\n    x = seed\n    for i in range(n):\n        x = (x * 1103515245 + 12345) % 2147483648\n        out[i] = (x % 1000) / 250.0 + 0.5\n    return out\n\n\ndef ifill(n: int, seed: int) -> list[int]:\n    out = [0] * n\n    x = seed\n    for i in range(n):\n        x = (x * 1103515245 + 12345) % 2147483648\n        out[i] = x % 1000\n    return out\n\n\ndef kernel(xs: list[float], ys: list[float]) -> None:\n    for i in range(len(xs)):\n        ys[i] = xs[i] * 3.0\n\n\ndef main() -> None:\n    n = int(sys.argv[1])\n    reps = int(sys.argv[2])\n    x = fill(n, 1)\n    y = [0.0] * n\n    for r in range(reps):\n        kernel(x, y)\n    print(sum(y))\n\n\nmain()\n"
 },
 "default_tuning": {

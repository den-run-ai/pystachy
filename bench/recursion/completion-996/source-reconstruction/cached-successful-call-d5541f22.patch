diff --git a/tests/programs/language/recursion_checked_leaf.py b/tests/programs/language/recursion_checked_leaf.py
new file mode 100644
index 00000000..4e73ca25
--- /dev/null
+++ b/tests/programs/language/recursion_checked_leaf.py
@@ -0,0 +1,86 @@
+# A previous successful child can prove another leaf check redundant, but a
+# function entry or a loop backedge cannot prove that the FIRST child fits.
+import sys
+
+seen: list[int] = [0, 0, 0, 0]
+pending: list[int] = []
+
+
+def step(value: int) -> int:
+    seen[1] += 1
+    return value + 1
+
+
+def recursive(n: int) -> int:
+    if n == 0:
+        return 0
+    return recursive(n - 1) + 1
+
+
+def batch(n: int) -> int:
+    seen[0] += 1
+    result = 0
+    for i in range(n):
+        result += step(pending.pop())
+        result += step(1)
+        result += recursive(i)
+    seen[2] += 1
+    return result
+
+
+def one_spare(n: int) -> int:
+    if n == 0:
+        return -10
+    try:
+        result = one_spare(n - 1)
+    except RecursionError:
+        return 0
+    if result == 0:
+        starts = seen[0]
+        leaves = seen[1]
+        finishes = seen[2]
+        before = len(pending)
+        pending.append(7)
+        empty = batch(0)
+        try:
+            batch(1)
+        except RecursionError:
+            if (empty == 0 and seen[0] == starts + 2 and seen[1] == leaves
+                    and seen[2] == finishes + 1 and len(pending) == before):
+                return 1
+            return -1
+        return -2
+    return result
+
+
+def problem() -> ValueError:
+    seen[3] += 1
+    return ValueError("cold child")
+
+
+def cold(value: int) -> int:
+    if value < 0:
+        raise problem()
+    return value + 1
+
+
+def warmed(n: int, negative: bool) -> int:
+    result = step(0)
+    for i in range(n):
+        result += cold(-1 if negative else i)
+        result += recursive(i)
+    return result
+
+
+original = sys.getrecursionlimit()
+sys.setrecursionlimit(60)
+for repeat in range(3):
+    print("first call", one_spare(100) == 1)
+    pending.extend([2, 3, 4])
+    print("recovered", batch(3), warmed(3, False))
+sys.setrecursionlimit(original)
+try:
+    warmed(1, True)
+except ValueError as error:
+    print("cold", str(error), seen[3] == 1)
+print("after cold", warmed(3, False))
diff --git a/tools/test_typed_recursion_cached.py b/tools/test_typed_recursion_cached.py
new file mode 100644
index 00000000..8100bc36
--- /dev/null
+++ b/tools/test_typed_recursion_cached.py
@@ -0,0 +1,164 @@
+"""Successful child calls prove later leaf checks redundant in an active frame."""
+from pathlib import Path
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+from tools.test_typed_recursion import compile_source, operations
+
+
+PREFIX = '''
+def leaf(value: int) -> int:
+    return value + 1
+
+def recursive(n: int) -> int:
+    if n <= 0:
+        return 0
+    return recursive(n - 1) + 1
+'''
+
+
+class TypedRecursionCachedTests(unittest.TestCase):
+    def test_successful_preheader_call_removes_only_later_checks(self):
+        _, functions = compile_source(PREFIX + '''
+def kernel(n: int) -> int:
+    total = leaf(0)
+    for i in range(n):
+        total += leaf(i)
+        total += recursive(i)
+    return total
+print(kernel(3))
+''')
+        ops = operations(functions["@f.kernel"])
+        self.assertEqual(sum(op[:2] == ("call", "@f.leaf") for op in ops), 1)
+        self.assertEqual(sum(op[:2] == ("call", "@rc.f.leaf") for op in ops), 1)
+        self.assertTrue(any(op[:2] == ("rt", "recursion.enter") for op in ops))
+        self.assertFalse(any(op[:2] == ("rt", "recursion.room") for op in ops))
+        self.assertTrue(any(op[:2] == ("rt", "recursion.check") for op in operations(functions["@f.leaf"])))
+        self.assertFalse(any(op[:2] == ("rt", "recursion.check") for op in operations(functions["@rc.f.leaf"])))
+
+    def test_loop_backedge_does_not_prove_its_own_first_call(self):
+        _, functions = compile_source(PREFIX + '''
+def kernel(n: int) -> int:
+    total = 0
+    for i in range(n):
+        total += leaf(i)
+        total += recursive(i)
+    return total
+print(kernel(3))
+''')
+        self.assertFalse(any(name.startswith("@rc.") for name in functions))
+
+    def test_all_incoming_paths_need_a_successful_call(self):
+        _, functions = compile_source(PREFIX + '''
+def kernel(n: int, warm: bool) -> int:
+    total = 0
+    if warm:
+        total += leaf(0)
+    for i in range(n):
+        total += leaf(i)
+        total += recursive(i)
+    return total
+print(kernel(3, False))
+''')
+        self.assertFalse(any(name.startswith("@rc.") for name in functions))
+
+    def test_unknown_callback_invalidates_even_through_source_helper(self):
+        _, functions = compile_source(PREFIX + '''
+from collections.abc import Callable
+
+def helper(callback: Callable[[], int]) -> int:
+    return callback()
+
+def kernel(n: int, callback: Callable[[], int]) -> int:
+    total = leaf(0)
+    for i in range(n):
+        total += helper(callback)
+        total += leaf(i)
+    return total
+print(kernel(3, lambda: 1))
+''')
+        self.assertFalse(any(name.startswith("@rc.") for name in functions))
+
+    def test_public_setter_preserves_room_after_successful_child(self):
+        _, functions = compile_source(PREFIX + '''
+import sys
+
+def setter() -> int:
+    try:
+        sys.setrecursionlimit(1000)
+        raise ValueError("caught")
+    except ValueError:
+        return 1
+
+def kernel(n: int) -> int:
+    total = leaf(0)
+    for i in range(n):
+        total += setter()
+        total += leaf(i)
+    return total
+print(kernel(3))
+''')
+        self.assertTrue(any(op[:2] == ("call", "@rc.f.leaf") for op in operations(functions["@f.kernel"])))
+
+    def test_handler_root_and_disabled_regions_retain_checks(self):
+        source = PREFIX + '''
+def kernel(n: int) -> int:
+    total = leaf(0)
+    for i in range(n):
+        try:
+            total += recursive(i)
+        except RecursionError:
+            total += 1
+        total += leaf(i)
+    return total
+print(kernel(3))
+'''
+        for opt in ("", "-recursionregion", "-recursionleaf", "-all"):
+            _, functions = compile_source(source, opt=opt)
+            self.assertFalse(any(name.startswith("@rc.") for name in functions))
+
+    def test_tuple_clone_keeps_fresh_aggregate_return(self):
+        source = PREFIX.replace("    return value + 1", "    return (value, value + 1)", 1).replace(
+            "def leaf(value: int) -> int:", "def leaf(value: int) -> tuple[int, int]:") + """
+def kernel(n: int) -> int:
+    left, right = leaf(0)
+    total = left + right
+    for i in range(n):
+        left, right = leaf(i)
+        total += left + right + recursive(i)
+    return total
+print(kernel(3))
+"""
+        ir, functions = compile_source(source)
+        self.assertIn("@rc.f.leaf", functions)
+        self.assertIn("call {i64, i64} @v.rc.f.leaf(", ir)
+
+    def test_terminal_child_keeps_single_frame_publication(self):
+        source = PREFIX + '''
+def problem() -> ValueError:
+    return ValueError("failed")
+
+def cold(value: int) -> int:
+    if value < 0:
+        raise problem()
+    return value + 1
+
+def kernel(n: int) -> int:
+    total = leaf(0)
+    for i in range(n):
+        total += cold(i)
+        total += recursive(i)
+    return total
+print(kernel(3))
+'''
+        _, functions = compile_source(source)
+        cold = operations(functions["@rc.f.cold"])
+        self.assertFalse(any(op[:2] == ("rt", "recursion.check") for op in cold))
+        self.assertTrue(any(op[:2] == ("rt", "recursion.enter") for op in cold))
+        self.assertTrue(any(op[:2] == ("call", "@f.problem") for op in cold))
+        self.assertFalse(any(op[:2] == ("rt", "recursion.depth") for op in cold))
+
+
+if __name__ == "__main__":
+    unittest.main()

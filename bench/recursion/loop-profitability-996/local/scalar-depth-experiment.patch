+"""Scalar depth keeps source-call checks and the existing callable ABI."""
+from contextlib import redirect_stderr
+from io import StringIO
+from pathlib import Path
+import os
+import re
+import sys
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+
+from tools.test_typed_recursion import compile_source, operations
+from src.pystachy_compiler.gen import Gen
+from src.pystachy_compiler.specs import FXBIT
+
+
+VALUE_ONLY = "-recursionleaf,-recursionregion"
+CLOSED = '''
+def depth(n: int) -> int:
+    if n <= 0:
+        return 0
+    return depth(n - 1) + 1
+
+def even(n: int) -> bool:
+    if n <= 0:
+        return True
+    return odd(n - 1)
+
+def odd(n: int) -> bool:
+    if n <= 0:
+        return False
+    return even(n - 1)
+
+print(depth(3), even(4), odd(4))
+'''
+
+
+def definition(ir, name):
+    match = re.search(r"^define [^\n]* " + re.escape(name) + r"\([^\n]*\)[^\n]* \{\n.*?^}",
+                      ir, re.M | re.S)
+    if match is None:
+        raise AssertionError("missing LLVM definition: " + name)
+    return match.group(0)
+
+
+class TypedRecursionValueTests(unittest.TestCase):
+    def test_direct_and_mutual_recursion_pass_active_scalar_depth(self):
+        ir, functions = compile_source(CLOSED, opt=VALUE_ONLY)
+        for original, target in (("depth", "depth"), ("even", "odd"), ("odd", "even")):
+            with self.subTest(function=original):
+                name = "@rv.f." + original
+                self.assertIn(name, functions)
+                function = functions[name]
+                code = operations(function)
+                additions = [function["operands"][(label, at)]
+                             for label, _, block in function["blocks"]
+                             for at, instruction in enumerate(block)
+                             if instruction[:2] == ("scalar.bin", "add")
+                             and function["operands"][(label, at)][0] == ["%rdepth", "1"]]
+                self.assertEqual(len(additions), 1)
+                active = "%t" + str(additions[0][1][0])
+                calls = [function["operands"][(label, at)][0]
+                         for label, _, block in function["blocks"]
+                         for at, instruction in enumerate(block)
+                         if instruction[:2] == ("call", "@rv.f." + target)]
+                self.assertEqual(len(calls), 1)
+                self.assertEqual(calls[0][-1], active)
+                limits = [function["operands"][(label, at)][1]
+                          for label, _, block in function["blocks"]
+                          for at, instruction in enumerate(block)
+                          if instruction[:2] == ("recursion.limit", "")]
+                self.assertEqual(len(limits), 1)
+                limit = "%t" + str(limits[0][0])
+                self.assertTrue(any(instruction[:2] == ("scalar.cmp", "sge")
+                                    and function["operands"][(label, at)][0] == ["%rdepth", limit]
+                                    for label, _, block in function["blocks"]
+                                    for at, instruction in enumerate(block)))
+                self.assertTrue(any(op[:2] == ("rt", "recursion.error") for op in code))
+                self.assertTrue(function["fx"] & FXBIT["R"])
+                self.assertFalse(any(op[0] == "rt" and op[1] in (
+                    "recursion.enter", "recursion.leave", "recursion.depth",
+                    "recursion.restore", "recursion.check", "recursion.room") for op in code))
+                body = definition(ir, name)
+                self.assertIn("i64 %rdepth)", body.splitlines()[0])
+                self.assertNotRegex(body, r"store i64 [^\n]*@pys_recursion_state")

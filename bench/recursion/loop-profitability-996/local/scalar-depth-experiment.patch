+    def test_verifier_rejects_missing_or_wrong_typed_hidden_depth(self):
+        original = Gen.recursionvalue
+        for invalid in ("missing", "wrong_type"):
+            with self.subTest(invalid=invalid):
+                def corrupt(g):
+                    count = original(g)
+                    for fn in g.fns:
+                        for block in fn.blocks:
+                            for op in block.code:
+                                if op.op == "call" and op.s.startswith("@rv."):
+                                    if invalid == "missing":
+                                        op.a.pop()
+                                    else:
+                                        op.a[-1].t = "bool"
+                                    return count
+                    raise AssertionError("the mutation did not find a private call")
+
+                error = StringIO()
+                with patch.object(Gen, "recursionvalue", corrupt), \
+                        patch.dict(os.environ, {"PYSTACHY_IRCHECK": "1"}), \
+                        redirect_stderr(error), self.assertRaises(SystemExit) as raised:
+                    compile_source(CLOSED, opt=VALUE_ONLY)
+                self.assertEqual(raised.exception.code, 1)
+                self.assertIn("private scalar-depth call", error.getvalue())

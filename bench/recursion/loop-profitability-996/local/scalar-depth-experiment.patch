+    def test_numeric_identity_operands_precede_the_hidden_depth(self):
+        source = '''# pystachy: dynamic-any
+from typing import Any
+
+def identity(value: int) -> int:
+    return value
+
+def relay(value: int) -> int:
+    return identity(value)
+
+value: Any = int("1000")
+alias: Any = relay(value)
+print(value is alias)
+'''
+        for prefix in ("", "# pystachy: python-int\n"):
+            with self.subTest(promoting_int=bool(prefix)):
+                ir, functions = compile_source(prefix + source, opt=VALUE_ONLY)
+                control, _ = compile_source(prefix + source, opt=VALUE_ONLY + ",-recursionvalue")
+                public = definition(ir, "@f.identity").splitlines()[0]
+                self.assertEqual(public, definition(control, "@f.identity").splitlines()[0])
+                private = definition(ir, "@rv.f.identity").splitlines()[0]
+                expected = public.replace("@f.identity(", "@rv.f.identity(")
+                expected = expected.replace(") {", ", i64 %rdepth) {")
+                self.assertEqual(private, expected)
+                self.assertIn("ptr %aid0, ptr %idret, i64 %rdepth)", private)
+                relay = functions["@rv.f.relay"]
+                calls = [relay["operands"][(label, at)][0]
+                         for label, _, block in relay["blocks"]
+                         for at, instruction in enumerate(block)
+                         if instruction[:2] == ("call", "@rv.f.identity")]
+                self.assertEqual(len(calls), 1)
+                self.assertEqual(len(calls[0]), 4)

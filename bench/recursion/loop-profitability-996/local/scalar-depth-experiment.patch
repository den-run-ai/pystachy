--- /dev/null
+++ b/tests/programs/language/recursion_value.py
@@ -0,0 +1,61 @@
+# A closed loop's builtin failure crosses the scalar-depth boundary; later
+# direct and indirect calls must retain their caller's current limit and depth.
+import sys
+from collections.abc import Callable
+
+events: list[int] = []
+
+
+def fold(values: list[int], divisor: int) -> int:
+    total = 0
+    for value in values:
+        events.append(value)
+        total += value // divisor
+    return total
+
+
+def positive(n: int) -> bool:
+    return n > 0 and n < 10
+
+
+def depth(n: int) -> int:
+    if n == 0:
+        return 0
+    return 1 + depth(n - 1)
+
+
+def relay(n: int) -> int:
+    return depth(n)
+
+
+def indirect(callback: Callable[[int], int], n: int) -> int:
+    return callback(n)
+
+
+callbacks: list[Callable[[int], int]] = [relay]
+original = sys.getrecursionlimit()
+sys.setrecursionlimit(60)
+print("short circuit", positive(3), positive(0))
+for attempt in range(3):
+    events.clear()
+    print("loop", fold([6, 9, 12], 3), events)
+    events.clear()
+    try:
+        fold([5, 7], 0)
+    except ZeroDivisionError:
+        print("failure", events)
+    print("after failure", relay(3))
+    for callback in callbacks:
+        try:
+            indirect(callback, 100)
+        except RecursionError:
+            print("indirect caught")
+        print("after recursion", indirect(callback, 4), depth(3))
+sys.setrecursionlimit(180)
+print("raised limit", indirect(callbacks[0], 100))
+sys.setrecursionlimit(60)
+try:
+    relay(100)
+except RecursionError:
+    print("lowered caught", relay(3))
+sys.setrecursionlimit(original)

+def gen_recursionvalue(self) -> int:
+    # A closed source-call graph can carry depth as an immutable scalar. Every
+    # source entry still checks at its original call; returns need no state store.
+    # Move each body once and preserve its public address as a thin ABI adapter.
+    # This deliberately excludes every observer, including on exceptional paths.
+    if recursion_blocked(self):
+        return 0
+    nf = len(self.fns)
+    valid: list[bool] = []
+    bases: list[str] = []
+    back: list[list[int]] = [[] for _ in range(nf)]
+    bad: list[int] = []
+    for j in range(nf):
+        fn = self.fns[j]
+        ok = (fn.counted and not fn.coro and not fn.f.gen and not fn.f.export
+              and not fn.f.pyexport and not fn.f.extern and len(fn.tries) == 0
+              and fn.gdepth == "" and not fn.pads and fn.rarg == "" and not is_tuple(fn.f.ret))
+        code = fn.blocks[0].code
+        own = False
+        base = ""
+        if len(code) >= 2:
+            enter = code[0]
+            sub = code[1]
+            own = (enter.op == "rt" and enter.s == "recursion.enter" and len(enter.r) == 1
+                   and fn.rdepth == f"%t{enter.r[0]}" and sub.op == "scalar.bin"
+                   and sub.s == "sub" and sub.t == "int" and len(sub.r) == 1 and len(sub.a) == 2
+                   and sub.a[0].v == fn.rdepth and sub.a[1].v == "1")
+            if own:
+                base = f"%t{sub.r[0]}"
+        ok = ok and own
+        seen: dict[int, bool] = {}
+        for block in fn.blocks:
+            ok = ok and block.handler == ""
+            for at in range(len(block.code)):
+                op = block.code[at]
+                if own and block is fn.blocks[0] and at < 2:
+                    continue
+                if (own and op.op == "rt" and op.s == "recursion.restore"
+                        and len(op.a) == 1 and op.a[0].v == base):
+                    continue
+                if any(a.v != "" and a.v in [fn.rdepth, base] for a in op.a):
+                    ok = False
+                if op.op == "call" and op.s in self.fll:
+                    child = self.fll[op.s]
+                    if child not in seen:
+                        seen[child] = True
+                        back[child].append(j)
+                elif (op.op in ["throw", "landing", "init"] or op.op.startswith("gen.")
+                      or (op.op == "rt" and op.s in ["throw", "reraise"])
+                      or self.opfx(op, fn.fa) & (FXBIT["U"] | FXBIT["I"]) != 0):
+                    ok = False
+        valid.append(ok)
+        bases.append(base)
+        if not ok:
+            bad.append(j)
+    # Propagate exclusions, rather than assuming recursive cycles have finite
+    # depth. A wholly closed cycle remains eligible and checks every activation.
+    pos = 0
+    while pos < len(bad):
+        child = bad[pos]
+        pos += 1
+        for parent in back[child]:
+            if valid[parent]:
+                valid[parent] = False
+                bad.append(parent)
+    selected = [j for j in range(nf) if valid[j]]
+    if len(selected) == 0:
+        return 0
+    names: dict[str, str] = {}
+    for j in selected:
+        names[self.fns[j].f.ll] = "@rv." + self.fns[j].f.ll[1:]
+    self.runtime("pys_recursion_depth")
+    self.runtime("pys_recursion_error")
+    for j in selected:
+        fn = self.fns[j]
+        private = recursion_partial_header(fn, names[fn.f.ll])
+        private.f.name = fn.f.name + "$recursionvalue"
+        private.counted = True
+        private.rarg = "%rdepth"
+        private.rdepth = fn.rdepth
+        # Only the private body retains these loops; the public wrapper has none.
+        private.loops = fn.loops
+        entry = Blk("entry")
+        limit = Ins("recursion.limit", "int", "")
+        private.n += 1
+        limit.r = [private.n]
+        full = Ins("scalar.cmp", "bool", "sge")
+        full.a = [Val(private.rarg, "int"), Val(f"%t{private.n}", "int")]
+        private.n += 1
+        full.r = [private.n]
+        private.n += 1
+        body = f"L{private.n}"
+        private.n += 1
+        overflow = Blk(f"L{private.n}")
+        branch = Ins("cbr", "", "")
+        branch.a = [Val(f"%t{full.r[0]}", "bool")]
+        branch.b = [overflow.label, body]
+        entry.code = [limit, full, branch]
+        private.blocks = [entry]
+        for block in fn.blocks:
+            copied = Blk(body if block is fn.blocks[0] else block.label)
+            if block is fn.blocks[0]:
+                active = Ins("scalar.bin", "int", "add")
+                active.a = [Val(private.rarg, "int"), Val("1", "int")]
+                active.r = [r for r in block.code[0].r]
+                copied.code.append(active)
+            for at in range(len(block.code)):
+                op = block.code[at]
+                if block is fn.blocks[0] and at < 2:
+                    continue
+                if (op.op == "rt" and op.s == "recursion.restore"
+                        and len(op.a) == 1 and op.a[0].v == bases[j]):
+                    continue
+                item = recursion_copy(op)
+                item.b = [body if label == "entry" else label for label in item.b]
+                copied.code.append(item)
+            private.blocks.append(copied)
+        error = Ins("rt", "None", "recursion.error")
+        overflow.code = [error, Ins("unreachable", "", "")]
+        private.blocks.append(overflow)
+        self.fll[private.f.ll] = len(self.fns)
+        self.fns.append(private)
+        # The original signature and address still handle callbacks and foreign
+        # callers. Argument evaluation is complete before this adapter is entered.
+        entry = Blk("entry")
+        depth = Ins("rt", "int", "recursion.depth")
+        fn.n += 1
+        depth.r = [fn.n]
+        call = Ins("call", fn.f.ret, private.f.ll)
+        call.a = [Val(f"%a{p}", fn.f.ptypes[p]) for p in fn.ps]
+        if identity_abi(fn.f):
+            call.a.extend([Val(f"%aid{p}", "dyn") for p in fn.ps if numeric_identity(fn.f.ptypes[p])])
+            if numeric_identity(fn.f.ret):
+                call.a.append(Val("%idret", "*dyn"))
+        call.a.append(Val(f"%t{depth.r[0]}", "int"))
+        ret = Ins("ret", "", "")
+        if fn.f.ret != "None":
+            fn.n += 1
+            call.r = [fn.n]
+            ret.a = [Val(f"%t{fn.n}", fn.f.ret)]
+        entry.code = [depth, call, ret]
+        fn.blocks = [entry]
+        fn.slots = []
+        fn.loops = []
+        fn.cold = {}
+        fn.fa = {}
+        fn.rdepth = ""
+    # Closed bodies pass their immutable active depth directly. Other callers
+    # read the currently published depth at the call, after argument evaluation;
+    # this also handles generators resumed under a different caller and adapters
+    # without an entry-depth token. No new operand is added to an indirect ABI.
+    for fn in self.fns:
+        for block in fn.blocks:
+            code = []
+            for op in block.code:
+                if op.op == "call" and op.s in names:
+                    depth_value = fn.rdepth
+                    if fn.rarg == "":
+                        depth = Ins("rt", "int", "recursion.depth")
+                        fn.n += 1
+                        depth.r = [fn.n]
+                        depth_value = f"%t{fn.n}"
+                        code.append(depth)
+                    op.s = names[op.s]
+                    op.a.append(Val(depth_value, "int"))
+                code.append(op)
+            block.code = code
+    return len(selected)
+
+

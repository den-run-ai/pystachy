+                self.assertTrue(any(op[:2] == ("call", "@f.leaf") for op in ops))
+
+    def test_calls_on_every_continuing_branch_allow_a_selector(self):
+        _, functions = compile_source('''
+def left(n: int) -> int:
+    return n + 1
+
+def right(n: int) -> int:
+    return n - 1
+
+def kernel(n: int, stop: int) -> int:
+    total = 0
+    for i in range(n):
+        if i == stop:

{"id": 175, "api": "repair_json", "input": "[1// c\\ud83d\n", "flags": {"return_objects": false, "ensure_ascii": false, "schema": {"items": {"type": "object", "properties": {"n\u00e9": {"allOf": [{"type": "number", "exclusiveMinimum": 1}, {"type": "integer"}, {"type": "integer"}]}, "tags": {"type": "string", "default": false}}, "dependentRequired": {"n\u00e9": ["x-1", "name"]}}, "$defs": {"item": {"type": "object", "properties": {"user id": {"type": "string", "maxLength": 1}, "n\u00e9": {"prefixItems": [{"type": "number", "multipleOf": 0.1}], "items": true}, "x-1": {"type": "object", "properties": {"tags": {"type": "integer", "enum": [1, 10]}, "user id": {"type": "boolean"}, "b": {"type": "number", "maximum": 10}, "x-1": {"type": "boolean", "const": false}}, "required": ["tags", "user id", "b"], "unevaluatedProperties": {"type": "string"}}, "tags": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 2.5}, {"type": "string", "format": "email"}], "items": false}}, "additionalProperties": {"type": "number", "exclusiveMaximum": 10}}, "node": {"items": {"if": false, "then": {"type": ["array"]}}, "minItems": 0, "contains": {"const": "a"}}}}, "schema_repair_mode": "salvage"}, "expected": {"value": ["str", [91, 93]]}}

{"id": 34, "api": "repair_json", "input": "{\"v\": 12.5}", "flags": {"return_objects": true, "logging": true, "schema": {"type": "object", "properties": {"v": {"allOf": [{"type": "number"}, {"maximum": 10}]}}}, "schema_repair_mode": "standard"}, "expected": {"error": "ValueError", "message": "12.5 is greater than the maximum of 10"}}
{"id": 35, "api": "repair_json", "input": "{\"v\": null}", "flags": {"return_objects": true, "logging": true, "schema": {"type": "object", "properties": {"v": {"type": ["string", "null"]}}}, "schema_repair_mode": "standard"}, "expected": {"value": ["tuple", [["dict", [[["str", [118]], ["none"]]]], ["list", []]]]}}
{"id": 36, "api": "repair_json", "input": "{\"v\": \"abc\"}", "flags": {"return_objects": true, "logging": true, "schema": {"type": "object", "properties": {"v": {"type": "string", "pattern": "^[0-9]+$"}}}, "schema_repair_mode": "standard"}, "expected": {"error": "ValueError", "message": "'abc' does not match '^[0-9]+$'"}}
{"id": 37, "api": "repair_json", "input": "{\"v\": \"abc\"}", "flags": {"return_objects": true, "logging": true, "schema": {"type": "object", "properties": {"v": {"type": "string", "maxLength": 2}}}, "schema_repair_mode": "standard"}, "expected": {"error": "ValueError", "message": "'abc' is too long"}}
{"id": 38, "api": "repair_json", "input": "{\"v\": 7}", "flags": {"return_objects": true, "logging": true, "schema": {"type": "object", "properties": {"v": {"type": "integer", "multipleOf": 2}}}, "schema_repair_mode": "standard"}, "expected": {"error": "ValueError", "message": "7 is not a multiple of 2"}}
{"id": 39, "api": "repair_json", "input": "{\"v\": [1, 1]}", "flags": {"return_objects": true, "logging": true, "schema": {"type": "object", "properties": {"v": {"type": "array", "uniqueItems": true}}}, "schema_repair_mode": "standard"}, "expected": {"error": "ValueError", "message": "[1, 1] has non-unique elements"}}
{"id": 40, "api": "repair_json", "input": "{\"a\": 1}", "flags": {"return_objects": true, "logging": true, "schema": {"type": "object", "dependentRequired": {"a": ["b"]}}, "schema_repair_mode": "standard"}, "expected": {"error": "ValueError", "message": "'b' is a dependency of 'a'"}}
{"id": 41, "api": "repair_json", "input": "{\"a\": 1, \"b\": 2}", "flags": {"return_objects": true, "logging": true, "schema": {"type": "object", "properties": {"a": {}}, "unevaluatedProperties": false}, "schema_repair_mode": "standard"}, "expected": {"error": "ValueError", "message": "Unevaluated properties are not allowed ('b' was unexpected)"}}
{"id": 42, "api": "repair_json", "input": "{\"a\": 1}", "flags": {"return_objects": true, "logging": true, "schema": {"if": {"required": ["a"]}, "then": {"required": ["b"]}, "else": {"required": ["c"]}}, "schema_repair_mode": "standard"}, "expected": {"error": "ValueError", "message": "'b' is a required property"}}
{"id": 43, "api": "repair_json", "input": "{\"a\": 1}", "flags": {"return_objects": true, "logging": true, "schema": {"not": {"required": ["a"]}}, "schema_repair_mode": "standard"}, "expected": {"error": "ValueError", "message": "{'a': 1} should not be valid under {'required': ['a']}"}}
{"id": 44, "api": "repair_json", "input": "{\"a\": 1}", "flags": {"return_objects": true, "logging": true, "schema": {"$ref": "#/$defs/missing"}, "schema_repair_mode": "standard"}, "expected": {"error": "SchemaDefinitionError", "message": "Unresolvable $ref: #/$defs/missing"}}
{"id": 45, "api": "repair_json", "input": "{\"a\": 1}", "flags": {"return_objects": true, "logging": true, "schema": {"$ref": "other.json#/a"}, "schema_repair_mode": "standard"}, "expected": {"error": "SchemaDefinitionError", "message": "Unsupported $ref: other.json#/a"}}
{"id": 46, "api": "repair_json", "input": "{\"a\": 1}", "flags": {"return_objects": true, "logging": true, "schema": {"$ref": 3}, "schema_repair_mode": "standard"}, "expected": {"error": "SchemaDefinitionError", "message": "Invalid schema: 3 is not of type 'string'"}}
{"id": 47, "api": "repair_json", "input": "{\"a\": 1}", "flags": {"return_objects": true, "logging": true, "schema": {"type": "objekt"}, "schema_repair_mode": "standard"}, "expected": {"error": "SchemaDefinitionError", "message": "Invalid schema: 'objekt' is not valid under any of the given schemas"}}
{"id": 48, "api": "repair_json", "input": "{\"a\": 1}", "flags": {"return_objects": true, "logging": true, "schema": {"properties": {"a": {"type": "string", "pattern": "("}}}, "schema_repair_mode": "standard"}, "expected": {"error": "SchemaDefinitionError", "message": "Invalid schema: '(' is not a 'regex'"}}
{"id": 49, "api": "repair_json", "input": "{\"a\": 1}", "flags": {"return_objects": true, "logging": true, "schema": {"required": "a"}, "schema_repair_mode": "standard"}, "expected": {"error": "SchemaDefinitionError", "message": "Invalid schema: 'a' is not of type 'array'"}}
{"id": 50, "api": "repair_json", "input": "{\"a\": 1}", "flags": {"return_objects": true, "logging": true, "schema": {"type": "object", "properties": {"a": {"minimum": "1"}}}, "schema_repair_mode": "standard"}, "expected": {"error": "SchemaDefinitionError", "message": "Invalid schema: '1' is not of type 'number'"}}
{"id": 51, "api": "repair_json", "input": "{\"a\": 1}", "flags": {"return_objects": true, "logging": true, "schema": true, "schema_repair_mode": "standard"}, "expected": {"value": ["tuple", [["dict", [[["str", [97]], ["int", "1"]]]], ["list", []]]]}}
{"id": 52, "api": "repair_json", "input": "{\"a\": 1}", "flags": {"return_objects": true, "logging": true, "schema": true, "schema_repair_mode": "salvage"}, "expected": {"value": ["tuple", [["dict", [[["str", [97]], ["int", "1"]]]], ["list", []]]]}}
{"id": 53, "api": "repair_json", "input": "{\"a\": 1}", "flags": {"return_objects": true, "logging": true, "schema": false, "schema_repair_mode": "standard"}, "expected": {"error": "ValueError", "message": "Schema does not allow any values."}}
{"id": 54, "api": "repair_json", "input": "{\"a\": 1", "flags": {"return_objects": true, "logging": true, "schema": {}, "schema_repair_mode": "standard"}, "expected": {"value": ["tuple", [["dict", [[["str", [97]], ["int", "1"]]]], ["list", []]]]}}
{"id": 55, "api": "repair_json", "input": "{\"a\": \"1\", \"b\": [true, \"no\"]}", "flags": {"return_objects": true, "logging": true, "schema": {"type": "object", "properties": {"a": {"type": "number"}, "b": {"type": "array", "items": {"type": "boolean"}}}}, "schema_repair_mode": "standard"}, "expected": {"value": ["tuple", [["dict", [[["str", [97]], ["float-repr", "1.0"]], [["str", [98]], ["list", [["bool", true], ["bool", false]]]]]], ["list", [["dict", [[["str", [116, 101, 120, 116]], ["str", [67, 111, 101, 114, 99, 101, 100, 32, 115, 116, 114, 105, 110, 103, 32, 116, 111, 32, 110, 117, 109, 98, 101, 114]]], [["str", [99, 111, 110, 116, 101, 120, 116]], ["str", [36, 46, 97]]]]], ["dict", [[["str", [116, 101, 120, 116]], ["str", [67, 111, 101, 114, 99, 101, 100, 32, 115, 116, 114, 105, 110, 103, 32, 116, 111, 32, 98, 111, 111, 108, 101, 97, 110]]], [["str", [99, 111, 110, 116, 101, 120, 116]], ["str", [36, 46, 98, 91, 49, 93]]]]]]]]]}}
{"id": 56, "api": "repair_json", "input": "{\"n\": 1e400, \"big\": 123456789012345678901234567890, \"f\": \"1e3\"}", "flags": {"return_objects": true, "logging": true, "schema": {"type": "object", "properties": {"n": {"type": "number"}, "big": {"type": "integer"}, "f": {"type": "integer"}}}, "schema_repair_mode": "standard"}, "expected": {"value": ["tuple", [["dict", [[["str", [110]], ["float-repr", "inf"]], [["str", [98, 105, 103]], ["int", "123456789012345678901234567890"]], [["str", [102]], ["int", "1000"]]]], ["list", [["dict", [[["str", [116, 101, 120, 116]], ["str", [67, 111, 101, 114, 99, 101, 100, 32, 110, 117, 109, 98, 101, 114, 32, 116, 111, 32, 105, 110, 116, 101, 103, 101, 114]]], [["str", [99, 111, 110, 116, 101, 120, 116]], ["str", [36, 46, 102]]]]]]]]]}}
{"id": 57, "api": "repair_json", "input": "{\"n\u00e9\": \"\u00e9t\u00e9\", \"x\": \"\\ud83d\\ude00\"}", "flags": {"return_objects": true, "logging": true, "schema": {"type": "object", "properties": {"n\u00e9": {"type": "string", "minLength": 4}}}, "schema_repair_mode": "standard"}, "expected": {"error": "ValueError", "message": "'\u00e9t\u00e9' is too short"}}
{"id": 58, "api": "repair_json", "input": "2.5\u0660\u0663", "flags": {"return_objects": true, "stream_stable": true, "schema": {"type": "string", "minLength": 2, "default": "", "$defs": {"node": false, "a": {"allOf": [{"type": "null"}, {"type": "boolean"}, {"if": {"type": "null"}, "else": {"type": "integer"}}]}}}}, "expected": {"error": "ValueError", "message": "'' is too short"}}
{"id": 59, "api": "loads", "input": "{\"id\":[0],\"name\":false,\"talse,\"tags\":null}", "flags": {"skip_json_loads": true, "logging": true, "schema": {"type": "object", "properties": {"id": {"type": "number", "exclusiveMinimum": 1}, "name": {"anyOf": [{"type": "integer", "maximum": 100, "default": 1604}, {"type": "boolean"}, {"type": "string"}]}, "tags": {"type": "null"}}, "required": ["id", "name"], "patternProperties": {"^a": {"type": "string", "pattern": "\\d"}}}, "schema_repair_mode": "salvage"}, "expected": {"error": "ValueError", "message": "Expected number at $.id."}}
{"id": 60, "api": "loads", "input": "{'name': {}, 'tags': False}", "flags": {"skip_json_loads": true, "logging": true, "schema": {"type": "object", "properties": {"name": true, "tags": {"type": "boolean"}}, "required": ["tags"], "dependentRequired": {"name": ["name"]}}}, "expected": {"value": ["tuple", [["dict", [[["str", [110, 97, 109, 101]], ["dict", []]], [["str", [116, 97, 103, 115]], ["bool", false]]]], ["list", []]]]}}
{"id": 61, "api": "repair_json", "input": "{'name': {}, 'tags': False}", "flags": {"return_objects": true, "skip_json_loads": true, "schema": {"type": "object", "properties": {"name": true, "tags": {"type": "boolean"}}, "required": ["tags"], "dependentRequired": {"name": ["name"]}}}, "expected": {"value": ["dict", [[["str", [110, 97, 109, 101]], ["dict", []]], [["str", [116, 97, 103, 115]], ["bool", false]]]]}}
{"id": 62, "api": "repair_json", "input": "{'name': {}, 'tags': False}", "flags": {"return_objects": false, "schema": {"type": "object", "properties": {"name": true, "tags": {"type": "boolean"}}, "required": ["tags"], "dependentRequired": {"name": ["name"]}}}, "expected": {"value": ["str", [123, 34, 110, 97, 109, 101, 34, 58, 32, 123, 125, 44, 32, 34, 116, 97, 103, 115, 34, 58, 32, 102, 97, 108, 115, 101, 125]]}}
{"id": 63, "api": "loads", "input": "{\"name\":{\"n\u00e9\":{\"a\":\"it's\",\"name\":{\"# no\":\"// no\"}}},\"n\u00e9\":\"key\"}{\"key\": \"val\\", "flags": {"schema": {"type": "object", "properties": {"name": {"type": "object", "properties": {"n\u00e9": {"type": "object", "properties": {"a": {"type": "string"}, "name": {}}, "additionalProperties": {"type": "null"}}}, "required": ["n\u00e9"], "patternProperties": {"^x-": {"type": "object", "properties": {"b": {"type": "boolean"}, "n\u00e9": {"type": "integer", "minimum": 1}, "x-1": true, "tags": {"type": "boolean"}}, "required": ["b", "x-1", "tags"]}}}, "user id": {"type": "integer", "maximum": 100}, "n\u00e9": true}}}, "expected": {"error": "ValueError", "message": "[{'name': {'n\u00e9': {'a': \"it's\", 'name': {'# no': '// no'}}}, 'n\u00e9': 'key'}, {'key': 'val\\\\'}] is not of type 'object'"}}
{"id": 64, "api": "loads", "input": "```json\n\"o\u001ff\"\n```", "flags": {"schema": {"oneOf": [{"type": "boolean", "default": 1713}, {"not": {"type": "null"}}, {"type": "object", "properties": {"b": {"type": "integer", "enum": [0, 3]}, "a": {"type": "integer", "exclusiveMaximum": 10}}, "required": [], "dependentRequired": {"b": ["id", "n\u00e9"]}}]}}, "expected": {"value": ["str", []]}}
{"id": 65, "api": "repair_json", "input": "null", "flags": {"return_objects": false, "ensure_ascii": false, "schema": {"not": {"oneOf": [{"anyOf": [{"type": "number", "multipleOf": 0.5}]}, {"items": {"type": "string"}}]}}}, "expected": {"error": "ValueError", "message": "'' should not be valid under {'oneOf': [{'anyOf': [{'type': 'number', 'multipleOf': 0.5}]}, {'items': {'type': 'string'}}]}"}}
{"id": 66, "api": "repair_json", "input": "1e+201+201e+20\\x41", "flags": {"return_objects": true, "logging": true, "schema": {"properties": {"tags": {"type": "boolean"}}, "required": [], "propertyNames": {"pattern": "[0-9]+"}, "$defs": {"node": {"items": {"type": ["string", "boolean", "integer"]}, "maxItems": 3}}}, "schema_repair_mode": "quick"}, "expected": {"error": "ValueError", "message": "schema_repair_mode must be one of: standard, salvage."}}
{"id": 67, "api": "repair_json", "input": "[null, null, null]", "flags": {"return_objects": true, "schema": {"type": "array", "items": {"type": "null", "default": "true"}}}, "expected": {"value": ["list", [["none"], ["none"], ["none"]]]}}
{"id": 68, "api": "repair_json", "input": "[null, null, null]", "flags": {"return_objects": true, "skip_json_loads": true, "logging": true, "schema": {"type": "array", "items": {"type": "null", "default": "true"}}}, "expected": {"value": ["tuple", [["list", [["none"], ["none"], ["none"]]], ["list", []]]]}}
{"id": 69, "api": "loads", "input": "{\"name\":{\"/* no */\":[\"\u65e5\u672c\u8a9e{x}\"]},\"user id\":1.5,\"b\":{}}", "flags": {"skip_json_loads": true, "logging": true, "schema": {"type": "object", "properties": {"name": {"not": {"properties": {"x-1": {"type": "string", "maxLength": 3}}, "required": [], "additionalProperties": false}}, "tags": {"type": "boolean", "default": null}, "user id": {"type": "number", "exclusiveMinimum": 0}, "b": {"type": "object", "properties": {"x-1": {"type": "null"}}, "required": ["x-1"], "unevaluatedProperties": {"type": "string"}}}, "required": [], "unevaluatedProperties": {"type": "string"}}}, "expected": {"error": "ValueError", "message": "Missing required properties at $.b: x-1"}}
{"id": 70, "api": "repair_json", "input": "{\"x-1\": 2.5, \"n\\u00e9\": null, \"user id\": {\"x-1\": null, \"user id\": null}}", "flags": {"return_objects": true, "logging": true, "schema": {"type": "object", "properties": {"x-1": {"type": "string", "enum": ["// no", "back\\slash", "a:b"]}, "id": {}, "n\u00e9": {"type": "null"}, "user id": {"properties": {"x-1": {"type": "null"}, "user id": true}, "required": ["x-1"], "propertyNames": {"pattern": "^x-"}}}, "required": ["n\u00e9", "user id", "x-1"], "unevaluatedProperties": {"type": "string"}}}, "expected": {"error": "ValueError", "message": "Value at $.x-1 does not match enum."}}
{"id": 71, "api": "repair_json", "input": "{\"user id\": -0.5,, \"a\": null,, \"name\": {\"tab\\t\": 1620,, \"back\\\\slash\": \"\u65e5\u672c\u8a9e\"}}", "flags": {"return_objects": true, "schema": {"type": "object", "properties": {"user id": {"type": "number", "multipleOf": 0.1}, "a": {"type": "null"}}, "required": ["user id"], "minProperties": 1}, "schema_repair_mode": "salvage"}, "expected": {"value": ["dict", [[["str", [117, 115, 101, 114, 32, 105, 100]], ["float-repr", "-0.5"]], [["str", [97]], ["none"]], [["str", [110, 97, 109, 101]], ["dict", [[["str", [116, 97, 98, 9]], ["int", "1620"]], [["str", [98, 97, 99, 107, 92, 115, 108, 97, 115, 104]], ["str", [26085, 26412, 35486]]]]]]]]}}
{"id": 72, "api": "loads", "input": "{\"user id\": -0.5,, \"a\": null,, \"name\": {\"tab\\t\": 1620,, \"back\\\\slash\": \"\u65e5\u672c\u8a9e\"}}", "flags": {"skip_json_loads": true, "schema": {"type": "object", "properties": {"user id": {"type": "number", "multipleOf": 0.1}, "a": {"type": "null"}}, "required": ["user id"], "minProperties": 1}, "schema_repair_mode": "salvage"}, "expected": {"value": ["dict", [[["str", [117, 115, 101, 114, 32, 105, 100]], ["float-repr", "-0.5"]], [["str", [97]], ["none"]], [["str", [110, 97, 109, 101]], ["dict", [[["str", [116, 97, 98, 9]], ["int", "1620"]], [["str", [98, 97, 99, 107, 92, 115, 108, 97, 115, 104]], ["str", [26085, 26412, 35486]]]]]]]]}}
{"id": 73, "api": "repair_json", "input": "{\"user id\": -0.5,, \"a\": null,, \"name\": {\"tab\\t\": 1620,, \"back\\\\slash\": \"\u65e5\u672c\u8a9e\"}}", "flags": {"return_objects": true, "strict": true, "schema": {"type": "object", "properties": {"user id": {"type": "number", "multipleOf": 0.1}, "a": {"type": "null"}}, "required": ["user id"], "minProperties": 1}, "schema_repair_mode": "salvage"}, "expected": {"error": "ValueError", "message": "schema and strict cannot be used together."}}
{"id": 74, "api": "repair_json", "input": "{\"a\": [],  \"user id\": null,  \"x-9\": {\"say \\\"hi\\\"\": \"key\"}}", "flags": {"return_objects": true, "skip_json_loads": true, "schema": {"type": "object", "properties": {"a": {"items": {"type": ["boolean"]}, "minItems": 1}, "user id": {"type": "null"}}, "additionalProperties": {"type": "null"}}, "schema_repair_mode": "salvage"}, "expected": {"error": "ValueError", "message": "Array at $.a does not meet minItems."}}
{"id": 75, "api": "repair_json", "input": "[false, false,  ]", "flags": {"return_objects": false, "ensure_ascii": false, "schema": true, "schema_repair_mode": "standard"}, "expected": {"value": ["str", [91, 102, 97, 108, 115, 101, 44, 32, 102, 97, 108, 115, 101, 93]]}}
{"id": 76, "api": "repair_json", "input": "[false, false,  ]", "flags": {"return_objects": true, "logging": true, "schema": true, "schema_repair_mode": "standard"}, "expected": {"value": ["tuple", [["list", [["bool", false], ["bool", false]]], ["list", []]]]}}
{"id": 77, "api": "repair_json", "input": "{'b': [], 'name': [10, '1e+20.0', -0.5], 'a': 'true', 'id': true}", "flags": {"return_objects": true, "skip_json_loads": true, "schema": {"type": "object", "properties": {"b": {"items": {"type": ["object", "array", "integer"]}, "maxItems": 0, "uniqueItems": true}, "name": {"type": "array", "items": {"type": "number", "multipleOf": 5, "default": "12it's"}}, "a": {"type": "boolean", "default": "back\\slash"}, "id": {"type": "boolean"}}, "required": ["name", "b", "a"], "minProperties": 0}, "schema_repair_mode": "salvage"}, "expected": {"error": "ValueError", "message": "-0.5 is not a multiple of 5"}}
{"id": 78, "api": "repair_json", "input": "{\"user id\": true  \"extra\": 1609}", "flags": {"return_objects": true, "schema": {"type": "object", "properties": {"user id": {"type": "boolean"}}, "required": ["user id"], "unevaluatedProperties": {"type": "string"}}}, "expected": {"error": "ValueError", "message": "Unevaluated properties are not valid under the given schema ('extra' was unevaluated and invalid)"}}
{"id": 79, "api": "repair_json", "input": "{'id': 'TRUE', 'n\u00e9': '12', 'extra': 0.5}", "flags": {"return_objects": true, "skip_json_loads": true, "logging": true, "schema": {"$schema": "http://json-schema.org/draft-06/schema#", "type": "object", "properties": {"id": {"type": "string", "default": " x y"}, "n\u00e9": {"type": "string", "maxLength": 4}}, "required": ["id", "n\u00e9"]}, "schema_repair_mode": "salvage"}, "expected": {"value": ["tuple", [["dict", [[["str", [105, 100]], ["str", [84, 82, 85, 69]]], [["str", [110, 233]], ["str", [49, 50]]], [["str", [101, 120, 116, 114, 97]], ["float-repr", "0.5"]]]], ["list", []]]]}}
{"id": 80, "api": "repair_json", "input": "{'id': 'TRUE', 'n\u00e9': '12', 'extra': 0.5}", "flags": {"return_objects": false, "ensure_ascii": false, "schema": {"$schema": "http://json-schema.org/draft-06/schema#", "type": "object", "properties": {"id": {"type": "string", "default": " x y"}, "n\u00e9": {"type": "string", "maxLength": 4}}, "required": ["id", "n\u00e9"]}, "schema_repair_mode": "salvage"}, "expected": {"value": ["str", [123, 34, 105, 100, 34, 58, 32, 34, 84, 82, 85, 69, 34, 44, 32, 34, 110, 233, 34, 58, 32, 34, 49, 50, 34, 44, 32, 34, 101, 120, 116, 114, 97, 34, 58, 32, 48, 46, 53, 125]]}}
{"id": 81, "api": "loads", "input": "\"true\"", "flags": {"logging": true, "schema": {"oneOf": [{"type": "boolean"}]}, "schema_repair_mode": "salvage"}, "expected": {"value": ["tuple", [["bool", true], ["list", [["dict", [[["str", [116, 101, 120, 116]], ["str", [67, 111, 101, 114, 99, 101, 100, 32, 115, 116, 114, 105, 110, 103, 32, 116, 111, 32, 98, 111, 111, 108, 101, 97, 110]]], [["str", [99, 111, 110, 116, 101, 120, 116]], ["str", [36]]]]]]]]]}}
{"id": 82, "api": "repair_json", "input": "\"true\"", "flags": {"return_objects": true, "stream_stable": true, "schema": {"oneOf": [{"type": "boolean"}]}, "schema_repair_mode": "salvage"}, "expected": {"value": ["bool", true]}}
{"id": 83, "api": "loads", "input": "{b: [], user id: 0}", "flags": {"skip_json_loads": true, "logging": true, "schema": {"properties": {"b": {"type": "array", "items": {"type": "string", "minLength": 3}, "contains": {"const": "a"}}, "user id": {"type": "null"}, "id": {"type": "object", "properties": {"tags": {"type": "array", "prefixItems": [{"type": "integer", "exclusiveMaximum": 100}, false], "contains": {"type": "integer"}}}, "required": ["tags"], "propertyNames": {"pattern": "^x-"}}}, "additionalProperties": {"type": "boolean"}}}, "expected": {"error": "ValueError", "message": "Expected object at $.id, got int."}}
{"id": 84, "api": "repair_json", "input": "\"{\\\"b\\\": 2.5, \\\"id\\\": [3.0, 0, \\\"off\\\"], \\\"x-9\\\": [true]}\"", "flags": {"return_objects": false, "schema": {"type": "object", "properties": {"b": {"type": "number", "exclusiveMaximum": 100}, "id": {"type": "object", "properties": {"a": {"type": "number", "exclusiveMaximum": 100}, "user id": {"type": "integer", "default": "/* no */"}, "x-1": {"type": "boolean"}}, "required": ["a"], "unevaluatedProperties": {"type": "string"}}}, "required": ["id"], "dependentRequired": {"b": ["x-1", "id"]}}}, "expected": {"error": "ValueError", "message": "Expected object at $.id, got list."}}
{"id": 85, "api": "loads", "input": "{\n \"a\": \"\ud83d\ude00\",\n \"id\": \"\",\n \"tags\": 0.0\n}", "flags": {"schema": {"type": "object", "properties": {"a": true, "id": {"type": "null"}, "tags": {"type": "number"}}, "required": ["id", "a"], "unevaluatedProperties": false}, "schema_repair_mode": "salvage"}, "expected": {"error": "ValueError", "message": "Expected null at $.id."}}
{"id": 86, "api": "loads", "input": "7", "flags": {"schema": {"type": "integer", "maximum": 10}}, "expected": {"value": ["int", "7"]}}

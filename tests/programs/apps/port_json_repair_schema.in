{"id": 177, "api": "loads", "input": "{\"id\":[0],\"name\":false,\"talse,\"tags\":null}", "flags": {"skip_json_loads": true, "logging": true, "schema": {"type": "object", "properties": {"id": {"type": "number", "exclusiveMinimum": 1}, "name": {"anyOf": [{"type": "integer", "maximum": 100, "default": 1604}, {"type": "boolean"}, {"type": "string"}]}, "tags": {"type": "null"}}, "required": ["id", "name"], "patternProperties": {"^a": {"type": "string", "pattern": "\\d"}}}, "schema_repair_mode": "salvage"}, "expected": {"error": "ValueError", "message": "Expected number at $.id."}}

{"id": 572, "api": "repair_json", "input": "null", "flags": {"return_objects": true, "schema": {"type": "null", "$defs": {"item": {"allOf": [{"type": "number", "exclusiveMaximum": 10}, {"type": "boolean"}, {"anyOf": [{"type": "null"}, {"type": "boolean"}, {"type": "string", "default": "12"}]}]}, "node": {"type": "integer", "exclusiveMaximum": 10}}}}, "expected": {"value": ["none"]}}

{"id": 674, "api": "repair_json", "input": "{\"name\": 3.0, \"x-1\": 1, \"id\": true, \"n\\u00e9\": []}", "flags": {"return_objects": true, "stream_stable": true, "schema": {"type": "object", "properties": {"name": {"type": "number"}, "x-1": {"type": ["integer"]}, "id": {"type": "boolean"}, "n\u00e9": {"type": "array", "items": {"anyOf": [{"type": "string", "minLength": 3}, {"type": "number", "enum": [3], "default": 3.0}]}, "uniqueItems": true}}, "required": ["id"], "additionalProperties": {"type": "array", "items": {"type": "null"}, "maxItems": 1, "uniqueItems": true}}, "schema_repair_mode": "standard"}, "expected": {"value": ["dict", [[["str", [110, 97, 109, 101]], ["float-repr", "3.0"]], [["str", [120, 45, 49]], ["int", "1"]], [["str", [105, 100]], ["bool", true]], [["str", [110, 233]], ["list", []]]]]}}

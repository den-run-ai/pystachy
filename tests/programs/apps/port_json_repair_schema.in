{"id": 576, "api": "repair_json", "input": "1e+20", "flags": {"return_objects": true, "stream_stable": true, "schema": {"$schema": "http://json-schema.org/draft-04/schema#", "type": "number", "multipleOf": 2, "default": null, "$defs": {"item": {"properties": {"id": {"allOf": [false]}, "a": {"type": "number"}, "tags": {"type": "integer", "minimum": 1}, "name": {"type": ["string"]}}, "additionalProperties": false}, "node": {"$ref": "#"}}}, "schema_repair_mode": "salvage"}, "expected": {"value": ["float-repr", "1e+20"]}}

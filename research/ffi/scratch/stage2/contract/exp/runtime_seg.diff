+/* ---------- library mode: a host process (CPython) calls compiled functions ----------
+   The host owns main, the signals and sys.stdout. pys_init_lib replaces pys_init: no argv, no
+   SIGINT/SIGPIPE handlers, no stdout emulation (writes go to the host through out_hook). Every
+   foreign entry brackets its calls with pys_enter(its frame address)/pys_leave(): the outermost
+   one bounds the stack scan, as @main's frame does for a program. Objects the host keeps between
+   calls are pinned. Single-threaded: the host must serialize entries (CPython's GIL, with
+   Py_mod_gil = Py_MOD_GIL_USED), and must not release it while compiled frames are live. */
+static int lib_inited;
+__attribute__((minsize)) void pys_init_lib(char *sb, I **roots, I nroots) {

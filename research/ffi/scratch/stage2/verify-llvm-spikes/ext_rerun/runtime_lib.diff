+/* ---------- library mode: a host process (CPython) calls compiled functions ----------
+   The host owns main, the signals and sys.stdout. pys_init_lib replaces pys_init: no argv, no
+   SIGINT/SIGPIPE handlers, no stdout emulation (writes go to the host through out_hook). Every
+   foreign entry brackets its calls with pys_enter(its frame address)/pys_leave(): the outermost
+   one bounds the stack scan, as @main's frame does for a program. Objects the host keeps between
+   calls are pinned. Single-threaded: the host must serialize entries (CPython's GIL, with
+   Py_mod_gil = Py_MOD_GIL_USED), and must not release it while compiled frames are live. */
+static int lib_inited;
+__attribute__((minsize)) void pys_init_lib(char *sb, I **roots, I nroots) {
+  if (lib_inited++) return;            /* a second import of the module (another interpreter, reload) */
+  gc_init(sb, roots, nroots);
+  args = pys_list_new(0);
+  std_in.f = stdin; std_in.rd = 1; std_in.nl = 2; std_in.std = 1;
+  std_out.f = stdout; std_out.wr = 1; std_out.std = 1;
+  std_err.f = stderr; std_err.wr = 1; std_err.std = 1;
+}
+void pys_enter(char *sb) { if (!t_depth++) t_bottom = sb + 2 * sizeof(void *); gc_bottom = t_bottom; }
+void pys_leave(void) { t_depth--; }
+/* a call out to the host, which may let another thread enter (CPython releases the GIL): the
+   caller spilled its registers (__builtin_unwind_init), and its frame up to this thread's
+   bottom stays a root until pys_out_end */
+__attribute__((noinline)) void *pys_out_begin(void) {
+  if (nspans == cspans && !(spans = realloc(spans, (cspans = 2 * cspans + 8) * sizeof *spans))) oom();
+  char *lo = __builtin_frame_address(0);
+  spans[nspans++] = (Span){lo, t_bottom};
+  return lo;
+}
+void pys_out_end(void *lo) {
+  for (I i = nspans - 1; i >= 0; i--) if (spans[i].lo == lo) { spans[i] = spans[--nspans]; break; }
+  gc_bottom = t_bottom;
+}
+void pys_set_out_hook(void (*h)(const char *, I, I)) { out_hook = h; }
+void pys_pin(void *p) {
+  if (npins == cpins && !(pins = realloc(pins, (cpins = 2 * cpins + 16) * sizeof *pins))) oom();
+  pins[npins++] = p;
+}
+void pys_unpin(void *p) {              /* the latest pin of p (LIFO is the common case) */
+  for (I i = npins - 1; i >= 0; i--) if (pins[i] == p) { pins[i] = pins[--npins]; return; }
+}

diff --git a/tools/rt_cpython/ffi.py b/tools/rt_cpython/ffi.py
new file mode 100644
index 0000000..c61f4e3
--- /dev/null
+++ b/tools/rt_cpython/ffi.py
@@ -0,0 +1,181 @@
+"""CPython's version of Pystachy's ffi module, so that a program that declares C functions with
+@extern runs under CPython too (put this directory on PYTHONPATH): ctypes calls the same C
+function, with the checks Pystachy's stubs make. A str goes in as its UTF-8 bytes (const char *,
+NUL-terminated; a NUL in it is a ValueError) and a returned char * comes back as a str (NULL:
+None, or a ValueError for -> str); C integers are range-checked (OverflowError), as Pystachy
+checks them."""
+import ast as _ast
+import ctypes
+import functools as _functools
+import inspect as _inspect
+import operator as _operator
+import threading as _threading
+import typing
+
+
+class c_int(int):
+    """C's int (32 bits) in an @extern function's signature; an int everywhere else"""
+
+
+class c_uint(int):
+    """C's unsigned int"""
+
+
+class c_int64(int):
+    """int64_t (long long)"""
+
+
+class c_ssize_t(int):
+    """ssize_t / Py_ssize_t"""
+
+
+class c_uint64(int):
+    """uint64_t"""
+
+
+class c_size_t(int):
+    """size_t"""
+
+
+class c_buf(str):
+    """a str's UTF-8 bytes (NULs allowed) for a C function that also takes their length"""
+
+
+class c_void_p(int):
+    """a pointer, as an int (NULL is 0)"""
+
+
+_C = {c_int: ctypes.c_int, c_uint: ctypes.c_uint, c_int64: ctypes.c_int64, c_ssize_t: ctypes.c_ssize_t,
+      c_uint64: ctypes.c_uint64, c_size_t: ctypes.c_size_t, c_void_p: ctypes.c_void_p,
+      c_buf: ctypes.c_char_p, float: ctypes.c_double, str: ctypes.c_char_p, type(None): None, typing.Optional[str]: ctypes.c_char_p}
+
+
+def _check(t, v):
+    if t is str:
+        if "\0" in v:
+            raise ValueError("embedded null character")
+        return v.encode("utf-8", "surrogatepass")
+    if t is c_buf:
+        return v.encode("utf-8", "surrogatepass")
+    if t is float:
+        return float(v)
+    if t is c_int and not -2**31 <= v < 2**31:
+        raise OverflowError("Python int too large to convert to C int")
+    if t in (c_uint, c_uint64, c_size_t) and v < 0:
+        raise OverflowError("can't convert negative int to unsigned")
+    if t is c_uint and v >= 2**32:
+        raise OverflowError("Python int too large to convert to C unsigned int")
+    if t in (c_int64, c_ssize_t, c_uint64, c_size_t, c_void_p) and not -2**63 <= v < 2**63:
+        raise OverflowError("int too big to convert")  # (Pystachy's int is 64-bit: checked where it was made)
+    return v
+
+
+def _s(b):
+    return None if b is None else b.decode("utf-8", "surrogatepass")
+
+
+def extern(lib, symbol=""):
+    # the def's own signature binds a call's arguments (keywords and defaults as for any def), then
+    # ctypes calls the C function, found when the def runs, as Pystachy finds it then
+    def deco(f):
+        hints = typing.get_type_hints(f)
+        ret = hints.pop("return")
+        sig = _inspect.signature(f)
+        ts = [hints[p] for p in sig.parameters]
+        for t in ts + [ret]:
+            if t is int:
+                raise TypeError(f"C function {f.__name__}() takes or returns int: say which C integer type")
+        cf = getattr(ctypes.CDLL(lib or None), symbol or f.__name__)
+        cf.argtypes = [_C[t] for t in ts]
+        cf.restype = _C[ret]
+
+        def call(*args, **kwargs):
+            b = sig.bind(*args, **kwargs)
+            b.apply_defaults()
+            r = cf(*[_check(t, b.arguments[p]) for t, p in zip(ts, sig.parameters)])
+            if ret is str and r is None:
+                raise ValueError("a C function declared -> str returned NULL")
+            if ret is c_void_p:
+                return r or 0  # (ctypes gives None for NULL)
+            if ret in (c_uint64, c_size_t) and r >= 2**63:
+                raise OverflowError("C unsigned result is too large for int")
+            return _s(r) if ret in (str, typing.Optional[str]) else r
+
+        call.__name__ = f.__name__
+        return call
+
+    return deco
+
+
+def string_at(addr, n):
+    if n < 0:
+        raise ValueError("ffi.string_at() takes a length >= 0")  # (ctypes reads up to a NUL)
+    return _s(ctypes.string_at(addr, n))
+
+
+# @export: a function of a module that `pystachy ext` compiles into a CPython extension module.
+# Under CPython the module's source runs, and this wrapper makes each call what pyext.c's
+# trampoline makes it: positional arguments only, converted and checked as the extension
+# converts them, results checked against Pystachy's 64-bit int, only the importing thread may
+# call, and an exception leaves as the builtin class Pystachy raises it as (its nearest builtin
+# base for one of the module's own classes) with args rebuilt from their repr, else (str(e),).
+
+
+def _in(name, i, t, x):
+    if t is int:
+        v = _operator.index(x)
+        if not -2**63 <= v < 2**63:
+            raise OverflowError("int too big to convert")
+        return v
+    if t is float:
+        if not (hasattr(type(x), "__float__") or hasattr(type(x), "__index__")):
+            raise TypeError(f"must be real number, not {type(x).__name__}")
+        return float(x)
+    if t is bool:
+        if x is not True and x is not False:
+            raise TypeError(f"{name}() argument {i + 1} must be bool")
+        return x
+    if not isinstance(x, str):
+        raise TypeError("expected str")
+    return x[:]  # (a plain str)
+
+
+def _out(t, r):
+    if t is int and not -2**63 <= r < 2**63:
+        raise OverflowError("integer result does not fit in 64 bits")
+    return float(r) if t is float else r
+
+
+def export(f):
+    hints = _typing_hints(f)
+    ret = hints.pop("return")
+    ts = list(hints.values())
+    owner = _threading.get_ident()
+    name = f.__name__
+
+    @_functools.wraps(f)
+    def call(*args, **kw):
+        if _threading.get_ident() != owner:
+            raise RuntimeError(f"{name}() is compiled by Pystachy, whose runtime is single-threaded: call it from the thread that imported its module")
+        if kw:
+            raise TypeError(f"{name}() takes no keyword arguments")
+        if len(args) != len(ts):
+            raise TypeError(f"{name}() takes {len(ts)} positional arguments but {len(args)} were given")
+        a = [_in(name, i, t, x) for i, (t, x) in enumerate(zip(ts, args))]
+        try:
+            return _out(ret, f(*a))
+        except BaseException as e:
+            c = type(e)
+            if c.__module__ != "builtins":
+                c = next(k for k in c.__mro__ if k.__module__ == "builtins")
+            try:
+                ea = _ast.literal_eval(repr(e.args))
+            except Exception:
+                ea = (str(e),)
+            raise c(*ea) from None
+
+    return call
+
+
+def _typing_hints(f):
+    return typing.get_type_hints(f)
diff --git a/tools/rt_cpython/pyobj.py b/tools/rt_cpython/pyobj.py
new file mode 100644
index 0000000..71b01ee
--- /dev/null
+++ b/tools/rt_cpython/pyobj.py
@@ -0,0 +1,143 @@
+"""CPython's version of Pystachy's lib/pyobj.py: the same API over the running interpreter's own
+objects (put this directory on PYTHONPATH). A Python exception is raised again as the first
+builtin class in its __mro__ that Pystachy has, with the same str(), as lib/pyobj.py does. A
+program may use what __all__ names (Pystachy rejects the rest at compile time); an Object comes
+only from these functions and its methods."""
+import builtins as _builtins
+import importlib as _importlib
+import operator as _operator
+import sys as _sys
+
+__all__ = ["Object", "import_module", "of_int", "of_float", "of_str", "of_list"]
+
+_BUILTIN = ["KeyError", "IndexError", "ZeroDivisionError", "OverflowError", "ValueError", "TypeError",
+            "AttributeError", "ModuleNotFoundError", "ImportError", "NotImplementedError", "RecursionError",
+            "RuntimeError", "FileNotFoundError", "OSError", "StopIteration", "AssertionError", "LookupError",
+            "ArithmeticError", "EOFError", "KeyboardInterrupt", "SystemExit", "Exception"]
+
+
+_CLOSED = object()
+
+
+def _live(o):
+    if o is _CLOSED:
+        raise ValueError("operation on a closed Python object")
+    return o
+
+
+def _builtin(e, again=True):
+    # e as the builtin class Pystachy raises it as, with str(e); if str(e) raises, what it raised (once)
+    k = next((c.__name__ for c in type(e).__mro__ if c.__name__ in _BUILTIN), "Exception")
+    k = "RuntimeError" if k == "RecursionError" else k
+    try:
+        m = str(e)
+    except Exception as e2:
+        if not again:
+            m = "<exception str() failed>"
+        else:
+            return _builtin(e2, False)
+    return getattr(_builtins, k)(m)
+
+
+def _guard(f, *a):
+    try:
+        return f(*a)
+    except (SystemExit, KeyboardInterrupt):
+        raise
+    except BaseException as e:
+        raise _builtin(e) from None
+
+
+def _flush():
+    # before a call: what was printed so far reaches sys.stdout's file first (a failure is dropped)
+    try:
+        if _sys.stdout is not None:
+            _sys.stdout.flush()
+    except Exception:
+        pass
+
+
+def _as_int(o):
+    # PyLong_AsLongLong: __index__, then C's long long
+    v = _operator.index(o)
+    if not -2**63 <= v < 2**63:
+        raise OverflowError("int too big to convert")
+    return v
+
+
+def _as_float(o):
+    # PyFloat_AsDouble: a float, or __float__, or __index__ (no str: float() would parse it)
+    if isinstance(o, float):
+        return float(o)
+    if hasattr(type(o), "__float__"):
+        return float(o)
+    if hasattr(type(o), "__index__"):
+        return float(_operator.index(o))
+    raise TypeError(f"must be real number, not {type(o).__name__}")
+
+
+class Object:
+    __slots__ = ("_o",)
+
+    def __init__(self, *args, **kwargs):
+        raise TypeError("pyobj.Object() cannot be called: import_module, of_int, of_float, of_str and of_list make Objects")
+
+    def close(self):
+        self._o = _CLOSED
+
+    def attr(self, name):
+        return _wrap(_guard(getattr, _live(self._o), name))
+
+    def call(self, args):
+        f, a = _live(self._o), [_live(x._o) for x in args]
+        _flush()
+        return _wrap(_guard(f, *a))
+
+    def __getitem__(self, k):
+        o, i = _live(self._o), _live(k._o)
+        return _wrap(_guard(lambda: o[i]))
+
+    def __len__(self):
+        return _guard(len, _live(self._o))
+
+    def __bool__(self):
+        return _guard(bool, _live(self._o))
+
+    def to_int(self):
+        return _guard(_as_int, _live(self._o))
+
+    def to_float(self):
+        return _guard(_as_float, _live(self._o))
+
+    def __str__(self):
+        return _guard(str, _live(self._o))
+
+    def __repr__(self):
+        return _guard(repr, _live(self._o))
+
+
+def _wrap(o):
+    x = object.__new__(Object)
+    x._o = o
+    return x
+
+
+def import_module(name):
+    return _wrap(_guard(_importlib.import_module, name))
+
+
+def of_int(v):
+    return _wrap(v)
+
+
+def of_float(x):
+    return _wrap(x)
+
+
+def of_str(s):
+    return _wrap(s)
+
+
+def of_list(xs):
+    return _wrap([_live(x._o) for x in xs])
+

new file mode 100644
index 0000000..a23ec35
--- /dev/null
+++ b/tests/ffi/ext/fastmath.py
@@ -0,0 +1,94 @@
+"""Numeric helpers: run by CPython as they are, or compiled by `pystachy ext` into fastmath.abi3.so"""
+import sys
+from ffi import export
+
+_calls = 0
+
+
+@export
+def fib(n: int) -> int:
+    global _calls
+    _calls += 1
+    a, b = 0, 1
+    for _ in range(n):
+        a, b = b, a + b
+    return a
+
+
+@export
+def check(n: int) -> int:
+    if n < 0:
+        raise ValueError(f"negative: {n}")
+    return n * 2
+
+
+@export
+def shout(s: str) -> str:
+    return s.upper() + "!"
+
+
+@export
+def words(s: str) -> int:
+    counts: dict[str, int] = {}
+    for w in s.split():
+        counts[w] = counts.get(w, 0) + 1
+    return len(counts)
+
+
+@export
+def hello(name: str) -> None:
+    print("hello from Pystachy,", name)
+
+
+@export
+def ncalls() -> int:
+    return _calls
+
+
+@export
+def bye(code: int) -> None:
+    sys.exit(code)
+
+
+class _TooBig(ValueError):
+    pass
+
+
+@export

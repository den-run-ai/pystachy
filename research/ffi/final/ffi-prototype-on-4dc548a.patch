+ctx.attr("__exit__").call([none, none, none])
+print("after:", repr(str(buf.attr("getvalue").call([]))))
+sys = import_module("sys")
+out = sys.attr("stdout")
+sys.attr("__setattr__").call([of_str("stdout"), none])
+print("not printed")
+sys.attr("__setattr__").call([of_str("stdout"), out])
+print("end")

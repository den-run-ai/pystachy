+        Py_DecRef(ct)
+        if tn == "int":
+            v = PyLong_AsLongLong(c)
+            Py_DecRef(c)
+            raise SystemExit(v)
+        m = _text(PyObject_Str(c))
+        Py_DecRef(c)
+        if tn == "NoneType":
+            raise SystemExit()
+        raise SystemExit(m)
+    m = _text(PyObject_Str(e))
+    Py_DecRef(e)
+    if k == "KeyboardInterrupt":
+        raise KeyboardInterrupt(m)
+    if k == "StopIteration":
+        raise StopIteration(m)
+    if k == "KeyError":
+        raise KeyError(m)
+    if k == "IndexError":
+        raise IndexError(m)
+    if k == "ZeroDivisionError":
+        raise ZeroDivisionError(m)
+    if k == "OverflowError":
+        raise OverflowError(m)
+    if k == "ValueError":
+        raise ValueError(m)
+    if k == "TypeError":
+        raise TypeError(m)
+    if k == "AttributeError":
+        raise AttributeError(m)
+    if k == "ModuleNotFoundError":
+        raise ModuleNotFoundError(m)
+    if k == "ImportError":
+        raise ImportError(m)
+    if k == "NotImplementedError":
+        raise NotImplementedError(m)
+    if k == "RuntimeError" or k == "RecursionError":
+        raise RuntimeError(m)
+    if k == "FileNotFoundError":
+        raise FileNotFoundError(m)
+    if k == "OSError":
+        raise OSError(m)
+    if k == "AssertionError":
+        raise AssertionError(m)
+    if k == "LookupError":
+        raise LookupError(m)
+    if k == "ArithmeticError":
+        raise ArithmeticError(m)
+    raise Exception(m)
+
+
+def _ref(p: int) -> "Object":
+    if p == 0:
+        _raise()
+    return Object(p)
+
+
+def _live(p: int) -> int:
+    if p == 0:
+        raise ValueError("operation on a closed Python object")
+    return p
+
+
+def _flush_py() -> None:
+    out = PySys_GetObject("stdout")  # (borrowed)
+    if out != 0:
+        f = PyObject_GetAttrString(out, "flush")
+        t = PyTuple_New(0)
+        r = PyObject_Call(f, t, 0) if f != 0 and t != 0 else 0
+        Py_DecRef(t)
+        Py_DecRef(f)
+        if r != 0:
+            Py_DecRef(r)
+
+
+class Object:
+    def __init__(self, p: int) -> None:
+        self.p = p  # a strong reference, a PyObject *; 0 once closed
+
+    def close(self) -> None:
+        if self.p != 0:
+            g = PyGILState_Ensure()
+            Py_DecRef(self.p)
+            PyGILState_Release(g)
+            self.p = 0
+
+    def attr(self, name: str) -> "Object":
+        p = _live(self.p)
+        g = PyGILState_Ensure()
+        try:
+            return _ref(PyObject_GetAttrString(p, name))
+        finally:
+            PyGILState_Release(g)
+
+    def call(self, args: list["Object"]) -> "Object":
+        p = _live(self.p)
+        for a in args:
+            _live(a.p)
+        if _embedded:
+            sys.stdout.flush()  # Pystachy's output first, then what Python prints, in order
+        g = PyGILState_Ensure()
+        try:
+            t = PyTuple_New(len(args))
+            if t == 0:
+                _raise()
+            for i in range(len(args)):
+                Py_IncRef(args[i].p)
+                PyTuple_SetItem(t, i, args[i].p)  # (steals the reference)
+            r = PyObject_Call(p, t, 0)
+            Py_DecRef(t)
+            if _embedded:
+                _flush_py()
+            return _ref(r)
+        finally:
+            PyGILState_Release(g)
+
+    def __getitem__(self, k: "Object") -> "Object":
+        p = _live(self.p)
+        q = _live(k.p)
+        g = PyGILState_Ensure()
+        try:
+            return _ref(PyObject_GetItem(p, q))
+        finally:
+            PyGILState_Release(g)
+
+    def __len__(self) -> int:
+        p = _live(self.p)
+        g = PyGILState_Ensure()
+        try:
+            n = PyObject_Length(p)
+            if n < 0:
+                _raise()
+            return n
+        finally:
+            PyGILState_Release(g)
+
+    def __bool__(self) -> bool:
+        p = _live(self.p)
+        g = PyGILState_Ensure()
+        try:
+            r = PyObject_IsTrue(p)
+            if r < 0:
+                _raise()
+            return r == 1
+        finally:
+            PyGILState_Release(g)
+
+    def to_int(self) -> int:
+        p = _live(self.p)
+        g = PyGILState_Ensure()
+        try:
+            v = PyLong_AsLongLong(p)
+            if v == -1 and PyErr_Occurred() != 0:
+                _raise()
+            return v
+        finally:
+            PyGILState_Release(g)
+
+    def to_float(self) -> float:
+        p = _live(self.p)
+        g = PyGILState_Ensure()
+        try:
+            v = PyFloat_AsDouble(p)
+            if v == -1.0 and PyErr_Occurred() != 0:
+                _raise()
+            return v
+        finally:
+            PyGILState_Release(g)
+
+    def __str__(self) -> str:
+        p = _live(self.p)
+        g = PyGILState_Ensure()
+        try:
+            r = PyObject_Str(p)
+            if r == 0:
+                _raise()
+            return _text(r)
+        finally:
+            PyGILState_Release(g)
+
+    def __repr__(self) -> str:
+        p = _live(self.p)
+        g = PyGILState_Ensure()
+        try:
+            r = PyObject_Repr(p)
+            if r == 0:
+                _raise()
+            return _text(r)
+        finally:
+            PyGILState_Release(g)
+
+
+def import_module(name: str) -> Object:
+    g = PyGILState_Ensure()
+    try:
+        return _ref(PyImport_ImportModule(name))
+    finally:
+        PyGILState_Release(g)
+
+
+def of_int(v: int) -> Object:
+    g = PyGILState_Ensure()
+    try:
+        return _ref(PyLong_FromLongLong(v))
+    finally:
+        PyGILState_Release(g)
+
+
+def of_float(x: float) -> Object:
+    g = PyGILState_Ensure()
+    try:
+        return _ref(PyFloat_FromDouble(x))
+    finally:
+        PyGILState_Release(g)
+
+
+def of_str(s: str) -> Object:
+    g = PyGILState_Ensure()
+    try:
+        return _ref(PyUnicode_DecodeUTF8(s, len(s), "surrogatepass"))
+    finally:
+        PyGILState_Release(g)
+
+
+def of_list(xs: list[Object]) -> Object:
+    for x in xs:
+        _live(x.p)
+    g = PyGILState_Ensure()
+    try:
+        r = _ref(PyList_New(0))
+        for x in xs:
+            if PyList_Append(r.p, x.p) < 0:
+                _raise()
+        return r
+    finally:
+        PyGILState_Release(g)
+
+
+if Py_IsInitialized() == 0:
+    # embedded: CPython as it runs the script (sys.argv, the script's directory first on sys.path),
+    # without its signal handlers (Pystachy keeps its own), then the GIL is released until a call
+    Py_InitializeEx(0)
+    _embedded = True
+    pye_at_exit()
+    _argv = PyList_New(0)
+    for _a in sys.argv:
+        _s = PyUnicode_DecodeUTF8(_a, len(_a), "surrogatepass")
+        PyList_Append(_argv, _s)
+        Py_DecRef(_s)
+    PySys_SetObject("argv", _argv)
+    Py_DecRef(_argv)
+    _d = os.path.realpath(sys.argv[0])
+    _d = _d[: _d.rfind("/")] if _d.rfind("/") > 0 else "/"
+    _path = PySys_GetObject("path")  # (borrowed)
+    _ins = PyObject_GetAttrString(_path, "insert")
+    _t = PyTuple_New(2)
+    PyTuple_SetItem(_t, 0, PyLong_FromLongLong(0))
+    PyTuple_SetItem(_t, 1, PyUnicode_DecodeUTF8(_d, len(_d), "surrogatepass"))
+    _r = PyObject_Call(_ins, _t, 0)
+    Py_DecRef(_r)
+    Py_DecRef(_t)
+    Py_DecRef(_ins)
+    PyEval_SaveThread()
diff --git apyembed.c bpyembed.c
new file mode 100644
index 0000000..9cf55aa
--- /dev/null
+++ bpyembed.c
@@ -0,0 +1,9 @@
+/* pyembed.c: linked into a program that imports lib/pyobj.py (and into its extension modules,
+   where it does nothing). A program that starts CPython (Py_InitializeEx) ends it the way
+   CPython ends: pys_finish, after the program's own output, attaches the main thread and runs
+   Py_FinalizeEx (Python threads joined, atexit handlers, sys.stdout flushed). No Python.h. */
+int PyGILState_Ensure(void);
+int Py_FinalizeEx(void);
+void pys_at_finish(void (*f)(void));
+static void finish(void) { PyGILState_Ensure(); Py_FinalizeEx(); }
+void pye_at_exit(void) { pys_at_finish(finish); }
diff --git apyext.c bpyext.c
new file mode 100644
index 0000000..df7042a
--- /dev/null
+++ bpyext.c
@@ -0,0 +1,235 @@
+/* pyext.c: a Pystachy program as a CPython extension module (pystachy ext). Linked only into
+   extension modules, with the program and the runtime, as one LLVM module whose only export is
+   the module's entry. It needs no Python.h and no Python to build: what it uses is CPython's
+   stable ABI, declared below as the ABI fixes it. Compiled twice from this one file:
+     default       abi3, CPython 3.12+ GIL builds: PyInit_<name>, PyModuleDef (multi-phase)
+     -DPYX_ABI3T   abi3t (PEP 803), CPython 3.15+ GIL and free-threaded builds: PyModExport_<name>
+                   returning a PEP 820 PySlot array (Py_mod_abi, Py_mod_gil = USED)
+   The program's IR (Gen.pyext) is the same for both: pyx_init, pyx_exports, and both entries,
+   of which the driver keeps one (internalize).
+   The runtime is single-threaded: only the thread that imported the module may call it. */
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+typedef int64_t I;
+typedef intptr_t Py_ssize_t;
+typedef struct _object PyObject;
+typedef struct { I len; char s[]; } Str;
+typedef struct Exc Exc;
+typedef struct { const char *name; void *meth; int flags; const char *doc; } PyMethodDef;
+/* CPython's stable ABI */
+extern PyObject PyUnicode_Type;
+extern PyObject *PyExc_TypeError, *PyExc_RuntimeError, *PyExc_BaseException, *PyExc_ImportError;
+PyObject *PyCFunction_NewEx(PyMethodDef *, PyObject *, PyObject *);
+int PyModule_AddObjectRef(PyObject *, const char *, PyObject *);
+PyObject *PyModule_GetNameObject(PyObject *);
+PyObject *PyImport_ImportModule(const char *);
+PyObject *PyObject_GetAttrString(PyObject *, const char *);
+PyObject *PyObject_VectorcallMethod(PyObject *, PyObject *const *, size_t, PyObject *);
+PyObject *PyObject_Vectorcall(PyObject *, PyObject *const *, size_t, PyObject *);
+PyObject *PyUnicode_FromString(const char *);
+PyObject *PyTuple_New(Py_ssize_t);
+int PyTuple_SetItem(PyObject *, Py_ssize_t, PyObject *);
+Py_ssize_t PyTuple_Size(PyObject *);
+PyObject *PySys_GetObject(const char *);
+int PyObject_IsInstance(PyObject *, PyObject *);
+int PyObject_IsSubclass(PyObject *, PyObject *);
+long long PyLong_AsLongLong(PyObject *);
+PyObject *PyLong_FromLongLong(long long);
+double PyFloat_AsDouble(PyObject *);
+PyObject *PyFloat_FromDouble(double);
+PyObject *PyBool_FromLong(long);
+const char *PyUnicode_AsUTF8AndSize(PyObject *, Py_ssize_t *);
+PyObject *PyUnicode_AsEncodedString(PyObject *, const char *, const char *);
+int PyBytes_AsStringAndSize(PyObject *, char **, Py_ssize_t *);
+PyObject *PyUnicode_DecodeUTF8(const char *, Py_ssize_t, const char *);
+PyObject *PyErr_Occurred(void);
+void PyErr_Clear(void);
+void PyErr_SetString(PyObject *, const char *);
+void PyErr_SetObject(PyObject *, PyObject *);
+PyObject *PyErr_Format(PyObject *, const char *, ...);
+void PyErr_WriteUnraisable(PyObject *);
+void Py_IncRef(PyObject *);
+void Py_DecRef(PyObject *);
+unsigned long PyThread_get_thread_ident(void);
+#define VC_OFFSET ((size_t)1 << (8 * sizeof(size_t) - 1))   /* PY_VECTORCALL_ARGUMENTS_OFFSET */
+#ifdef PYX_ABI3T
+PyObject *Py_GetConstantBorrowed(unsigned int);           /* 3.13+: None 0, False 1, True 2 */
+#define NONE Py_GetConstantBorrowed(0)
+#define FALSE Py_GetConstantBorrowed(1)
+#define TRUE Py_GetConstantBorrowed(2)
+#else
+extern PyObject _Py_NoneStruct, _Py_TrueStruct, _Py_FalseStruct;
+#define NONE (&_Py_NoneStruct)
+#define FALSE (&_Py_FalseStruct)
+#define TRUE (&_Py_TrueStruct)
+#endif
+/* the runtime (runtime.c) and the program (Gen.pyext) */
+Str *pys_str(const char *p, I n);
+Str *pys_exc_name(Exc *e);
+Str *pys_exc_str(Exc *e);
+Str *pys_exc_repr(Exc *e);
+void pys_enter(char *sb);
+void pys_leave(void);
+void pys_set_out_hook(void (*h)(const char *, I, I));
+Exc *pyx_init(void);
+typedef struct { const char *name, *sig; I (*fn)(I *, Exc **); } Export;
+extern const Export pyx_exports[];
+
+static unsigned long owner;            /* the thread that imported the module */
+static int printing;                   /* in out_hook: a print's ops are not calls (their effects are I/O), so the
+                                          Python code it runs (sys.stdout.write) may not call back into the module */
+static PyObject *builtins, *sys, *s_write;
+
+static PyObject *text(Str *s) { return PyUnicode_DecodeUTF8(s->s, s->len, "surrogatepass"); }
+static Str *to_str(PyObject *o) {      /* a str: one UTF-8 copy into the GC heap (lone surrogates kept) */
+  Py_ssize_t n; char *q;
+  if (PyObject_IsInstance(o, &PyUnicode_Type) != 1) return PyErr_Occurred() ? 0 : (PyErr_SetString(PyExc_TypeError, "expected str"), (Str *)0);
+  const char *p = PyUnicode_AsUTF8AndSize(o, &n);
+  if (p) return pys_str(p, n);
+  PyErr_Clear();
+  PyObject *b = PyUnicode_AsEncodedString(o, "utf-8", "surrogatepass");
+  if (!b) return 0;
+  PyBytes_AsStringAndSize(b, &q, &n);
+  Str *s = pys_str(q, n); Py_DecRef(b); return s;
+}
+static PyObject *args_of(Exc *e) {     /* e.args, rebuilt from repr(e) "Kind(a, b)" by ast.literal_eval, or (str(e),) */
+  Str *r = pys_exc_repr(e), *k = pys_exc_name(e);
+  PyObject *a = 0;
+  if (r->len >= k->len + 2 && r->s[k->len] == '(' && r->s[r->len - 1] == ')') {
+    I n = r->len - k->len - 2;
+    char *b = malloc(n + 4);
+    if (!b) return 0;
+    b[0] = '('; memcpy(b + 1, r->s + k->len + 1, n); memcpy(b + 1 + n, n ? ",)" : ")", 3);
+    PyObject *ast = PyImport_ImportModule("ast"), *f = ast ? PyObject_GetAttrString(ast, "literal_eval") : 0;
+    PyObject *t = f ? PyUnicode_DecodeUTF8(b, (Py_ssize_t)strlen(b), "surrogatepass") : 0;
+    a = t ? PyObject_Vectorcall(f, &t, 1, 0) : 0;
+    free(b); Py_DecRef(t); Py_DecRef(f); Py_DecRef(ast);
+    if (!a) PyErr_Clear();
+  }
+  if (!a) {                            /* (str(e),) */
+    PyObject *m = text(pys_exc_str(e));
+    if (m && (a = PyTuple_New(1))) PyTuple_SetItem(a, 0, m); else Py_DecRef(m);   /* (steals m) */
+  }
+  return a;
+}
+static PyObject *raised(Exc *e) {      /* a Pystachy exception, as the builtin class of its name, with its args */
+  Str *k = pys_exc_name(e);
+  PyObject *c = PyObject_GetAttrString(builtins, k->s), *a;
+  if (!c || PyObject_IsSubclass(c, PyExc_BaseException) != 1) {   /* a class of the program: RuntimeError("Name: msg")
+                                                                       (Gen's nearest-builtin table replaces this) */
+    PyErr_Clear(); Py_DecRef(c); PyObject *m = text(pys_exc_str(e));
+    PyErr_Format(PyExc_RuntimeError, "%s: %U", k->s, m); Py_DecRef(m); return 0;
+  }
+  if ((a = args_of(e))) PyErr_SetObject(c, a);   /* (a tuple: the class is called with it as args) */
+  Py_DecRef(a); Py_DecRef(c); return 0;
+}
+static PyObject *call(PyObject *self, PyObject *const *args, Py_ssize_t nargs, PyObject *kwnames) {
+  const Export *x = &pyx_exports[PyLong_AsLongLong(self)];
+  Py_ssize_t np = (Py_ssize_t)strlen(x->sig) - 1;
+  I a[np > 0 ? np : 1], r; Exc *err = 0; PyObject *res = 0; double d;
+  if (PyThread_get_thread_ident() != owner)
+    return PyErr_Format(PyExc_RuntimeError, "%s() is compiled by Pystachy, whose runtime is single-threaded: call it from the thread that imported its module", x->name);
+  if (printing) return PyErr_Format(PyExc_RuntimeError, "%s() called from sys.stdout.write while its module prints", x->name);
+  if (kwnames && PyTuple_Size(kwnames) > 0) return PyErr_Format(PyExc_TypeError, "%s() takes no keyword arguments", x->name);
+  if (nargs != np) return PyErr_Format(PyExc_TypeError, "%s() takes %d positional arguments but %d were given", x->name, (int)np, (int)nargs);
+  pys_enter(__builtin_frame_address(0));   /* (to_str allocates: this frame is scanned) */
+  for (Py_ssize_t i = 0; i < np; i++) {
+    PyObject *o = args[i];
+    switch (x->sig[i + 1]) {
+    case 'i': a[i] = PyLong_AsLongLong(o); if (a[i] == -1 && PyErr_Occurred()) goto out; break;
+    case 'f': d = PyFloat_AsDouble(o); if (d == -1.0 && PyErr_Occurred()) goto out; memcpy(&a[i], &d, 8); break;
+    case 'b': if (o != TRUE && o != FALSE) { PyErr_Format(PyExc_TypeError, "%s() argument %d must be bool", x->name, (int)i + 1); goto out; }
+              a[i] = o == TRUE; break;
+    default: if (!(a[i] = (I)to_str(o))) goto out;
+    }
+  }
+  r = x->fn(a, &err);
+  if (err) { res = raised(err); goto out; }
+  switch (x->sig[0]) {
+  case 'i': res = PyLong_FromLongLong(r); break;
+  case 'f': memcpy(&d, &r, 8); res = PyFloat_FromDouble(d); break;
+  case 'b': res = PyBool_FromLong((long)r); break;
+  case 's': res = text((Str *)r); break;
+  default: Py_IncRef(NONE); res = NONE;
+  }
+out:
+  pys_leave();
+  return res;
+}
+static void out_hook(const char *s, I n, I fd) {   /* print() and sys.stdout: Python's sys.stdout, in order */
+  PyObject *f = PySys_GetObject(fd == 2 ? "stderr" : "stdout"), *u = PyUnicode_DecodeUTF8(s, n, "surrogatepass");   /* (f borrowed) */
+  PyObject *v[2] = {f, u};
+  printing++;
+  PyObject *r = f && u ? PyObject_VectorcallMethod(s_write, v, 2 | VC_OFFSET, 0) : 0;
+  printing--;
+  if (!r) PyErr_WriteUnraisable(f);
+  Py_DecRef(r); Py_DecRef(u);
+}
+static PyMethodDef *defs;
+static int execed;
+static int exec_mod(PyObject *m) {
+  I n = 0; Exc *e;
+  if (execed++) { PyErr_SetString(PyExc_ImportError, "a Pystachy extension module runs its code once per process: it cannot be imported again"); return -1; }
+  owner = PyThread_get_thread_ident();
+  if (!(builtins = PyImport_ImportModule("builtins")) || !(sys = PyImport_ImportModule("sys")) || !(s_write = PyUnicode_FromString("write"))) return -1;
+#ifdef PYX_ABI3T
+  {                                    /* Py_mod_gil = USED turned the GIL on, unless PYTHON_GIL=0 / -X gil=0 forces it off */
+    PyObject *f = PyObject_GetAttrString(sys, "_is_gil_enabled"), *on = f ? PyObject_Vectorcall(f, 0, 0, 0) : 0;
+    Py_DecRef(f); Py_DecRef(on);
+    if (!on) return -1;
+    if (on == FALSE) { PyErr_SetString(PyExc_ImportError, "a Pystachy extension module needs the GIL (its runtime is single-threaded), which PYTHON_GIL=0 or -X gil=0 keeps off"); return -1; }
+  }
+#endif
+  pys_set_out_hook(out_hook);
+  pys_enter(__builtin_frame_address(0));
+  e = pyx_init();                      /* the runtime, then the module's code */
+  if (e) { raised(e); pys_leave(); return -1; }
+  pys_leave();
+  while (pyx_exports[n].name) n++;
+  if (!(defs = calloc(n + 1, sizeof *defs))) return -1;
+  PyObject *mn = PyModule_GetNameObject(m);
+  for (I i = 0; i < n; i++) {
+    defs[i] = (PyMethodDef){pyx_exports[i].name, (void *)call, 0x80 | 0x02 /* METH_FASTCALL | METH_KEYWORDS */, 0};
+    PyObject *k = PyLong_FromLongLong(i), *f = k ? PyCFunction_NewEx(&defs[i], k, mn) : 0;
+    int bad = !f || PyModule_AddObjectRef(m, pyx_exports[i].name, f) < 0;
+    Py_DecRef(f); Py_DecRef(k);
+    if (bad) { Py_DecRef(mn); return -1; }
+  }
+  Py_DecRef(mn);
+  return 0;
+}
+#ifdef PYX_ABI3T
+typedef struct { uint16_t id, flags; uint32_t reserved; void *p; } PySlot;
+typedef struct { uint8_t major, minor; uint16_t flags; uint32_t build_version, abi_version; } PyABIInfo;
+static PyABIInfo abi = {1, 0, 1 | 2 | 4 /* STABLE | GIL | FREETHREADED */, 0 /* built without CPython's headers */, 0x030F0000};
+static PySlot slots[] = {
+  {109 /* Py_mod_abi */, 2 /* PySlot_STATIC */, 0, &abi},
+  {100 /* Py_mod_name */, 2, 0, 0},
+  {85 /* Py_mod_exec */, 0, 0, (void *)exec_mod},
+  {87 /* Py_mod_gil */, 4 /* PySlot_INTPTR */, 0, 0 /* Py_MOD_GIL_USED: the runtime is single-threaded */},
+  {86 /* Py_mod_multiple_interpreters */, 4, 0, 0 /* NOT_SUPPORTED: one runtime per process */},
+  {0, 0, 0, 0}};
+PySlot *pyx_slots(const char *name) { slots[1].p = (void *)name; return slots; }
+#else
+typedef struct { Py_ssize_t refcnt; void *type, *init; Py_ssize_t index; void *copy; } PyModuleDef_Base;
+typedef struct { int slot; void *value; } PyModuleDef_Slot;
+typedef struct { PyModuleDef_Base base; const char *name, *doc; Py_ssize_t size; PyMethodDef *methods;
+                 PyModuleDef_Slot *slots; void *traverse, *clear, *free; } PyModuleDef;
+PyObject *PyModuleDef_Init(PyModuleDef *);
+static PyModuleDef_Slot slots[] = {{2 /* Py_mod_exec */, exec_mod},
+  {3 /* Py_mod_multiple_interpreters */, 0 /* NOT_SUPPORTED: one runtime per process */}, {0, 0}};
+static PyModuleDef def = {{1, 0, 0, 0, 0}, 0, 0, 0, 0, slots, 0, 0, 0};
+PyObject *pyx_module(const char *name) {
+  /* free-threaded 3.13 and 3.14 still load an .abi3.so and call this, though its PyModuleDef has the
+     GIL build's object header: refuse before CPython reads it (3.15t never loads .abi3.so) */
+  PyObject *fl = PySys_GetObject("abiflags");   /* (borrowed) */
+  const char *f = fl ? PyUnicode_AsUTF8AndSize(fl, 0) : 0;
+  if (f && strchr(f, 't')) {
+    PyErr_Format(PyExc_ImportError, "%s.abi3.so is built for CPython's GIL builds (abi3): on a free-threaded build, use the abi3t module (CPython 3.15+) or the source", name);
+    return 0;
+  }
+  PyErr_Clear();
+  def.name = name; return PyModuleDef_Init(&def);
+}
+#endif

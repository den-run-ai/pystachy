+
+
+_embedded = False  # this program started CPython (else: an extension module's host runs it)
+
+
+def _text(o: int) -> str:
+    # a Python str (a new reference, which this releases) as Pystachy's UTF-8 str
+    b = PyUnicode_AsEncodedString(o, "utf-8", "surrogatepass")
+    Py_DecRef(o)
+    if b == 0:
+        _raise()
+    s = string_at(PyBytes_AsString(b), PyBytes_Size(b))
+    Py_DecRef(b)
+    return s
+
+
+BUILTIN = ["KeyError", "IndexError", "ZeroDivisionError", "OverflowError", "ValueError", "TypeError",
+           "AttributeError", "ModuleNotFoundError", "ImportError", "NotImplementedError", "RecursionError",
+           "RuntimeError", "FileNotFoundError", "OSError", "StopIteration", "AssertionError", "LookupError",
+           "ArithmeticError", "KeyboardInterrupt", "SystemExit", "Exception"]
+
+
+def _raise() -> None:
+    # the Python exception just raised, as the first builtin class in its type's __mro__ that
+    # Pystachy has, with its str(); SystemExit keeps its code
+    e = PyErr_GetRaisedException()
+    t = PyObject_Type(e)
+    mro = PyObject_GetAttrString(t, "__mro__")
+    Py_DecRef(t)
+    k = "Exception"
+    for i in range(PyTuple_Size(mro)):
+        n = _text(PyObject_GetAttrString(PyTuple_GetItem(mro, i), "__name__"))  # (borrowed item)
+        if n in BUILTIN:

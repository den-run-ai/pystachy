diff --git alib/pyobj.py blib/pyobj.py
new file mode 100644
index 0000000..e056e39
--- /dev/null
+++ blib/pyobj.py
@@ -0,0 +1,416 @@
+"""Python objects for Pystachy code, through CPython's stable ABI (@ffi.extern). In a program,
+CPython runs embedded (PYSTACHY_LIBPYTHON names its libpython); in an extension module (pystachy
+ext) the host interpreter is used. tools/rt_cpython/pyobj.py is this module for CPython itself.
+
+An Object holds a reference until close(), or until a collection finds the Object dropped (the
+reference is then released by the next operation); a closed Object raises ValueError. A Python
+exception becomes the nearest builtin exception class Pystachy has, with the same str();
+SystemExit and KeyboardInterrupt stay what they are. Embedded, the program holds the GIL only
+inside these calls, so Python threads run while compiled code does, and CPython is finalized
+after the program ends (pyembed.c), as it is when it runs a script."""
+import os
+import sys
+from ffi import extern, c_int, c_int64, c_ssize_t, c_void_p, c_buf, string_at, track, untrack, collected
+
+
+@extern("python")
+def Py_IsInitialized() -> c_int: ...
+@extern("python")
+def Py_InitializeEx(sigs: c_int) -> None: ...
+@extern("python")
+def PyEval_SaveThread() -> c_void_p: ...
+@extern("python")
+def PyGILState_Ensure() -> c_int: ...
+@extern("python")
+def PyGILState_Release(g: c_int) -> None: ...
+@extern("python")
+def PyImport_ImportModule(name: str) -> c_void_p: ...
+@extern("python")
+def PyObject_GetAttrString(o: c_void_p, name: str) -> c_void_p: ...
+@extern("python")
+def Py_DecRef(o: c_void_p) -> None: ...
+@extern("python")
+def Py_IncRef(o: c_void_p) -> None: ...
+@extern("python")
+def PyLong_FromLongLong(v: c_int64) -> c_void_p: ...
+@extern("python")
+def PyLong_AsLongLong(o: c_void_p) -> c_int64: ...
+@extern("python")
+def PyFloat_FromDouble(x: float) -> c_void_p: ...
+@extern("python")
+def PyFloat_AsDouble(o: c_void_p) -> float: ...
+@extern("python")
+def PyUnicode_DecodeUTF8(s: c_buf, n: c_ssize_t, errors: str) -> c_void_p: ...
+@extern("python")
+def PyUnicode_AsEncodedString(o: c_void_p, encoding: str, errors: str) -> c_void_p: ...
+@extern("python")
+def PyBytes_Size(o: c_void_p) -> c_ssize_t: ...
+@extern("python")
+def PyBytes_AsString(o: c_void_p) -> c_void_p: ...
+@extern("python")
+def PyObject_Str(o: c_void_p) -> c_void_p: ...
+@extern("python")
+def PyObject_Repr(o: c_void_p) -> c_void_p: ...
+@extern("python")
+def PyTuple_New(n: c_ssize_t) -> c_void_p: ...
+@extern("python")
+def PyTuple_SetItem(t: c_void_p, i: c_ssize_t, o: c_void_p) -> c_int: ...
+@extern("python")
+def PyTuple_GetItem(t: c_void_p, i: c_ssize_t) -> c_void_p: ...
+@extern("python")
+def PyTuple_Size(t: c_void_p) -> c_ssize_t: ...
+@extern("python")
+def PyList_New(n: c_ssize_t) -> c_void_p: ...
+@extern("python")
+def PyList_Append(lst: c_void_p, o: c_void_p) -> c_int: ...
+@extern("python")
+def PyObject_Call(f: c_void_p, args: c_void_p, kwargs: c_void_p) -> c_void_p: ...
+@extern("python")
+def PyObject_GetItem(o: c_void_p, k: c_void_p) -> c_void_p: ...
+@extern("python")
+def PyObject_Length(o: c_void_p) -> c_ssize_t: ...
+@extern("python")
+def PyObject_IsTrue(o: c_void_p) -> c_int: ...
+@extern("python")
+def PyErr_Occurred() -> c_void_p: ...
+@extern("python")
+def PyErr_GetRaisedException() -> c_void_p: ...
+@extern("python")
+def PyErr_SetRaisedException(e: c_void_p) -> None: ...
+@extern("python")
+def PyObject_Type(o: c_void_p) -> c_void_p: ...
+@extern("python")
+def PySys_GetObject(name: str) -> c_void_p: ...
+@extern("python")
+def PySys_SetObject(name: str, o: c_void_p) -> c_int: ...
+@extern("")
+def pye_at_exit() -> None: ...  # (pyembed.c)
+
+
+_embedded = False  # this program started CPython (else: an extension module's host runs it)
+_depth = 0  # operations in progress (more than one: Python code called back into an extension module)
+
+
+def _text(o: int) -> str:
+    # a Python str (a new reference, which this releases) as Pystachy's UTF-8 str
+    b = PyUnicode_AsEncodedString(o, "utf-8", "surrogatepass")
+    Py_DecRef(o)
+    if b == 0:
+        _raise()
+    s = string_at(PyBytes_AsString(b), PyBytes_Size(b))
+    Py_DecRef(b)
+    return s
+
+
+BUILTIN = ["KeyError", "IndexError", "ZeroDivisionError", "OverflowError", "ValueError", "TypeError",
+           "AttributeError", "ModuleNotFoundError", "ImportError", "NotImplementedError", "RecursionError",
+           "RuntimeError", "FileNotFoundError", "OSError", "StopIteration", "AssertionError", "LookupError",
+           "ArithmeticError", "KeyboardInterrupt", "SystemExit", "Exception"]
+
+
+def _raise() -> None:
+    # the Python exception just raised, as the first builtin class in its type's __mro__ that
+    # Pystachy has, with its str(); SystemExit keeps its code
+    e = PyErr_GetRaisedException()
+    t = PyObject_Type(e)
+    mro = PyObject_GetAttrString(t, "__mro__")
+    Py_DecRef(t)
+    k = "Exception"
+    for i in range(PyTuple_Size(mro)):
+        n = _text(PyObject_GetAttrString(PyTuple_GetItem(mro, i), "__name__"))  # (borrowed item)
+        if n in BUILTIN:
+            k = n
+            break
+    Py_DecRef(mro)
+    if k == "SystemExit":
+        c = PyObject_GetAttrString(e, "code")
+        Py_DecRef(e)
+        ct = PyObject_Type(c)
+        tn = _text(PyObject_GetAttrString(ct, "__name__"))
+        Py_DecRef(ct)
+        if tn == "int" or tn == "bool":
+            v = PyLong_AsLongLong(c)
+            Py_DecRef(c)
+            raise SystemExit(v)
+        m = _text(PyObject_Str(c))
+        Py_DecRef(c)
+        if tn == "NoneType":
+            raise SystemExit()
+        raise SystemExit(m)
+    m = _text(PyObject_Str(e))
+    Py_DecRef(e)
+    if k == "KeyboardInterrupt":
+        raise KeyboardInterrupt(m)
+    if k == "StopIteration":
+        raise StopIteration(m)
+    if k == "KeyError":
+        raise KeyError(m)
+    if k == "IndexError":
+        raise IndexError(m)
+    if k == "ZeroDivisionError":
+        raise ZeroDivisionError(m)
+    if k == "OverflowError":
+        raise OverflowError(m)
+    if k == "ValueError":
+        raise ValueError(m)
+    if k == "TypeError":
+        raise TypeError(m)
+    if k == "AttributeError":
+        raise AttributeError(m)
+    if k == "ModuleNotFoundError":
+        raise ModuleNotFoundError(m)
+    if k == "ImportError":
+        raise ImportError(m)
+    if k == "NotImplementedError":
+        raise NotImplementedError(m)
+    if k == "RuntimeError" or k == "RecursionError":
+        raise RuntimeError(m)
+    if k == "FileNotFoundError":
+        raise FileNotFoundError(m)
+    if k == "OSError":
+        raise OSError(m)
+    if k == "AssertionError":
+        raise AssertionError(m)
+    if k == "LookupError":
+        raise LookupError(m)
+    if k == "ArithmeticError":
+        raise ArithmeticError(m)
+    raise Exception(m)
+
+
+def _enter() -> int:
+    # attach to CPython (the GIL) for one operation. The outermost one first releases the references
+    # of Objects that collections found dropped: here, not inside a collection (Py_DecRef runs Python
+    # code), and never while another operation is in progress, which may still be using a reference
+    # it read from an Object that has since been dropped (a nested one: Python code that the outer
+    # one called, calling back into an extension module)
+    global _depth
+    g = PyGILState_Ensure()
+    _depth += 1
+    v = collected() if _depth == 1 else 0
+    while v != 0:
+        Py_DecRef(v)
+        v = collected()
+    return g
+
+
+def _leave(g: int) -> None:
+    global _depth
+    _depth -= 1
+    PyGILState_Release(g)
+
+
+def _ref(p: int) -> "Object":
+    if p == 0:
+        _raise()
+    return Object(p)
+
+
+def _live(p: int) -> int:
+    if p == 0:
+        raise ValueError("operation on a closed Python object")
+    return p
+
+
+def _flush_py() -> None:
+    # Python's sys.stdout, after a call (its error, if any, is dropped: the call's is the one raised)
+    e = PyErr_GetRaisedException()  # (the call's, or 0)
+    out = PySys_GetObject("stdout")  # (borrowed)
+    if out != 0:
+        f = PyObject_GetAttrString(out, "flush")
+        t = PyTuple_New(0)
+        r = PyObject_Call(f, t, 0) if f != 0 and t != 0 else 0
+        Py_DecRef(t)
+        Py_DecRef(f)
+        if r != 0:
+            Py_DecRef(r)
+        Py_DecRef(PyErr_GetRaisedException())
+    if e != 0:
+        PyErr_SetRaisedException(e)
+
+
+class Object:
+    # every operation reads the reference only once attached (_enter): until then the Object is
+    # live, so the release _enter may run cannot be this Object's
+    def __init__(self, p: int) -> None:
+        self.p = p  # a strong reference, a PyObject *; 0 once closed
+        self.t: int = track(self, p)  # (released when a collection finds this Object dropped)
+
+    def close(self) -> None:
+        g = _enter()
+        try:
+            if self.p != 0:
+                Py_DecRef(self.p)
+                untrack(self.t)
+                self.p = 0
+        finally:
+            _leave(g)
+
+    def attr(self, name: str) -> "Object":
+        g = _enter()
+        try:
+            return _ref(PyObject_GetAttrString(_live(self.p), name))
+        finally:
+            _leave(g)
+
+    def call(self, args: list["Object"]) -> "Object":
+        if _embedded:
+            sys.stdout.flush()  # Pystachy's output first, then what Python prints, in order
+        g = _enter()
+        try:
+            p = _live(self.p)
+            for a in args:
+                _live(a.p)
+            t = PyTuple_New(len(args))
+            if t == 0:
+                _raise()
+            for i in range(len(args)):
+                Py_IncRef(args[i].p)
+                PyTuple_SetItem(t, i, args[i].p)  # (steals the reference)
+            r = PyObject_Call(p, t, 0)
+            Py_DecRef(t)
+            if _embedded:
+                _flush_py()
+            return _ref(r)
+        finally:
+            _leave(g)
+
+    def __getitem__(self, k: "Object") -> "Object":
+        g = _enter()
+        try:
+            return _ref(PyObject_GetItem(_live(self.p), _live(k.p)))
+        finally:
+            _leave(g)
+
+    def __len__(self) -> int:
+        g = _enter()
+        try:
+            n = PyObject_Length(_live(self.p))
+            if n < 0:
+                _raise()
+            return n
+        finally:
+            _leave(g)
+
+    def __bool__(self) -> bool:
+        g = _enter()
+        try:
+            r = PyObject_IsTrue(_live(self.p))
+            if r < 0:
+                _raise()
+            return r == 1
+        finally:
+            _leave(g)
+
+    def to_int(self) -> int:
+        g = _enter()
+        try:
+            v = PyLong_AsLongLong(_live(self.p))
+            if v == -1 and PyErr_Occurred() != 0:
+                _raise()
+            return v
+        finally:
+            _leave(g)
+
+    def to_float(self) -> float:
+        g = _enter()
+        try:
+            v = PyFloat_AsDouble(_live(self.p))
+            if v == -1.0 and PyErr_Occurred() != 0:
+                _raise()
+            return v
+        finally:
+            _leave(g)
+
+    def __str__(self) -> str:
+        g = _enter()
+        try:
+            r = PyObject_Str(_live(self.p))
+            if r == 0:
+                _raise()
+            return _text(r)
+        finally:
+            _leave(g)
+
+    def __repr__(self) -> str:
+        g = _enter()
+        try:
+            r = PyObject_Repr(_live(self.p))
+            if r == 0:
+                _raise()
+            return _text(r)
+        finally:
+            _leave(g)
+
+
+def import_module(name: str) -> Object:
+    g = _enter()
+    try:
+        return _ref(PyImport_ImportModule(name))
+    finally:
+        _leave(g)
+
+
+def of_int(v: int) -> Object:
+    g = _enter()
+    try:
+        return _ref(PyLong_FromLongLong(v))
+    finally:
+        _leave(g)
+
+
+def of_float(x: float) -> Object:
+    g = _enter()
+    try:
+        return _ref(PyFloat_FromDouble(x))
+    finally:
+        _leave(g)
+
+
+def of_str(s: str) -> Object:
+    g = _enter()
+    try:
+        return _ref(PyUnicode_DecodeUTF8(s, len(s), "surrogatepass"))
+    finally:
+        _leave(g)
+
+
+def of_list(xs: list[Object]) -> Object:
+    g = _enter()
+    try:
+        for x in xs:
+            _live(x.p)
+        r = _ref(PyList_New(0))
+        for x in xs:
+            if PyList_Append(r.p, x.p) < 0:
+                _raise()
+        return r
+    finally:
+        _leave(g)
+
+
+if Py_IsInitialized() == 0:
+    # embedded: CPython as it runs the script (sys.argv, the script's directory first on sys.path),
+    # without its signal handlers (Pystachy keeps its own), then the GIL is released until a call
+    Py_InitializeEx(0)
+    _embedded = True
+    pye_at_exit()
+    _argv = PyList_New(0)
+    for _a in sys.argv:
+        _s = PyUnicode_DecodeUTF8(_a, len(_a), "surrogatepass")
+        PyList_Append(_argv, _s)
+        Py_DecRef(_s)
+    PySys_SetObject("argv", _argv)
+    Py_DecRef(_argv)
+    _d = os.path.realpath(sys.argv[0])
+    _d = _d[: _d.rfind("/")] if _d.rfind("/") > 0 else "/"
+    _path = PySys_GetObject("path")  # (borrowed)
+    _ins = PyObject_GetAttrString(_path, "insert")
+    _t = PyTuple_New(2)
+    PyTuple_SetItem(_t, 0, PyLong_FromLongLong(0))
+    PyTuple_SetItem(_t, 1, PyUnicode_DecodeUTF8(_d, len(_d), "surrogatepass"))
+    _r = PyObject_Call(_ins, _t, 0)
+    Py_DecRef(_r)
+    Py_DecRef(_t)
+    Py_DecRef(_ins)
+    PyEval_SaveThread()
diff --git apyembed.c bpyembed.c
new file mode 100644
index 0000000..d1b0b64
--- /dev/null
+++ bpyembed.c
@@ -0,0 +1,17 @@
+/* pyembed.c: linked into a program that imports lib/pyobj.py (and into its extension modules,
+   where it does nothing). A program that starts CPython (Py_InitializeEx) ends it the way
+   CPython ends: pys_finish, after the program's own output, attaches the main thread, releases
+   the references Pystachy objects still own (ffi.track) and runs Py_FinalizeEx (Python threads
+   joined, atexit handlers, sys.stdout flushed). No Python.h. */
+#include <stdint.h>
+int PyGILState_Ensure(void);
+int Py_FinalizeEx(void);
+void Py_DecRef(void *);
+void pys_at_finish(void (*f)(void));
+int64_t pys_trk_pop(void);
+static void finish(void) {
+  PyGILState_Ensure();
+  for (int64_t v; (v = pys_trk_pop());) Py_DecRef((void *)(intptr_t)v);
+  Py_FinalizeEx();
+}
+void pye_at_exit(void) { pys_at_finish(finish); }
diff --git apyext.c bpyext.c
new file mode 100644
index 0000000..c37cdb8
--- /dev/null
+++ bpyext.c
@@ -0,0 +1,286 @@
+/* pyext.c: a Pystachy program as a CPython extension module (pystachy ext). Linked only into
+   extension modules, with the program and the runtime, as one LLVM module whose only export is
+   the module's entry. It needs no Python.h and no Python to build: what it uses is CPython's
+   stable ABI, declared below as the ABI fixes it. Compiled twice from this one file:
+     default       abi3, CPython 3.12+ GIL builds: PyInit_<name>, PyModuleDef (multi-phase)
+     -DPYX_ABI3T   abi3t (PEP 803), CPython 3.15+ GIL and free-threaded builds: PyModExport_<name>
+                   returning a PEP 820 PySlot array (Py_mod_abi, Py_mod_gil = USED)
+   The program's IR (Gen.pyext) is the same for both: pyx_init, pyx_exports, and both entries,
+   of which the driver keeps one (internalize).
+   The runtime is single-threaded: only the thread that imported the module may call it. */
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+typedef int64_t I;
+typedef intptr_t Py_ssize_t;
+typedef struct _object PyObject;
+typedef struct { I len; char s[]; } Str;
+typedef struct Exc Exc;
+typedef struct { const char *name; void *meth; int flags; const char *doc; } PyMethodDef;
+/* CPython's stable ABI */
+extern PyObject PyUnicode_Type;
+extern PyObject *PyExc_TypeError, *PyExc_RuntimeError, *PyExc_BaseException, *PyExc_ImportError;
+PyObject *PyCFunction_NewEx(PyMethodDef *, PyObject *, PyObject *);
+int PyModule_AddObjectRef(PyObject *, const char *, PyObject *);
+PyObject *PyModule_GetNameObject(PyObject *);
+PyObject *PyImport_ImportModule(const char *);
+PyObject *PyObject_GetAttrString(PyObject *, const char *);
+PyObject *PyObject_VectorcallMethod(PyObject *, PyObject *const *, size_t, PyObject *);
+PyObject *PyObject_Vectorcall(PyObject *, PyObject *const *, size_t, PyObject *);
+PyObject *PyUnicode_FromString(const char *);
+PyObject *PyTuple_New(Py_ssize_t);
+int PyTuple_SetItem(PyObject *, Py_ssize_t, PyObject *);
+PyObject *PyTuple_GetItem(PyObject *, Py_ssize_t);
+Py_ssize_t PyTuple_Size(PyObject *);
+PyObject *PySys_GetObject(const char *);
+int PyObject_IsInstance(PyObject *, PyObject *);
+int PyObject_IsSubclass(PyObject *, PyObject *);
+long long PyLong_AsLongLong(PyObject *);
+PyObject *PyLong_FromLongLong(long long);
+double PyFloat_AsDouble(PyObject *);
+PyObject *PyFloat_FromDouble(double);
+PyObject *PyBool_FromLong(long);
+const char *PyUnicode_AsUTF8AndSize(PyObject *, Py_ssize_t *);
+PyObject *PyUnicode_AsEncodedString(PyObject *, const char *, const char *);
+int PyBytes_AsStringAndSize(PyObject *, char **, Py_ssize_t *);
+PyObject *PyUnicode_DecodeUTF8(const char *, Py_ssize_t, const char *);
+PyObject *PyErr_Occurred(void);
+void PyErr_Clear(void);
+void PyErr_SetString(PyObject *, const char *);
+void PyErr_SetObject(PyObject *, PyObject *);
+PyObject *PyErr_Format(PyObject *, const char *, ...);
+PyObject *PyErr_GetRaisedException(void);
+PyObject *PyObject_Type(PyObject *);
+PyObject *PyObject_Str(PyObject *);
+Py_ssize_t PyList_Size(PyObject *);
+PyObject *PyList_GetItem(PyObject *, Py_ssize_t);
+void Py_IncRef(PyObject *);
+void Py_DecRef(PyObject *);
+unsigned long PyThread_get_thread_ident(void);
+#define VC_OFFSET ((size_t)1 << (8 * sizeof(size_t) - 1))   /* PY_VECTORCALL_ARGUMENTS_OFFSET */
+#ifdef PYX_ABI3T
+PyObject *Py_GetConstantBorrowed(unsigned int);           /* 3.13+: None 0, False 1, True 2 */
+#define NONE Py_GetConstantBorrowed(0)
+#define FALSE Py_GetConstantBorrowed(1)
+#define TRUE Py_GetConstantBorrowed(2)
+#else
+extern PyObject _Py_NoneStruct, _Py_TrueStruct, _Py_FalseStruct;
+#define NONE (&_Py_NoneStruct)
+#define FALSE (&_Py_FalseStruct)
+#define TRUE (&_Py_TrueStruct)
+#endif
+/* the runtime (runtime.c) and the program (Gen.pyext) */
+Str *pys_str(const char *p, I n);
+Str *pys_exc_name(Exc *e);
+Str *pys_exc_str(Exc *e);
+Str *pys_exc_repr(Exc *e);
+_Noreturn void pys_raise(Str *kind, Str *msg);
+typedef struct List List;
+List *pys_argv(void);
+void pys_list_append(List *l, I v);
+void pys_enter(char *sb);
+void pys_leave(void);
+void pys_set_out_hook(void (*h)(const char *, I, I));
+Exc *pyx_init(void);
+typedef struct { const char *name, *sig; I (*fn)(I *, Exc **); void *meth; } Export;   /* meth: @pyx.m.<name> */
+extern const Export pyx_exports[];
+typedef struct { const char *name, *base; } ExcBase;   /* the program's exception classes: nearest builtin base */
+extern const ExcBase pyx_excbase[];
+
+static unsigned long owner;            /* the thread that imported the module */
+static int printing;                   /* in out_hook: a print's ops are not calls (their effects are I/O), so the
+                                          Python code it runs (sys.stdout.write) may not call back into the module */
+static PyObject *builtins, *sys, *s_write;
+
+static PyObject *text(Str *s) { return PyUnicode_DecodeUTF8(s->s, s->len, "surrogatepass"); }
+static Str *to_str(PyObject *o) {      /* a str: one UTF-8 copy into the GC heap (lone surrogates kept) */
+  Py_ssize_t n; char *q;
+  if (PyObject_IsInstance(o, &PyUnicode_Type) != 1) return PyErr_Occurred() ? 0 : (PyErr_SetString(PyExc_TypeError, "expected str"), (Str *)0);
+  const char *p = PyUnicode_AsUTF8AndSize(o, &n);
+  if (p) return pys_str(p, n);
+  PyErr_Clear();
+  PyObject *b = PyUnicode_AsEncodedString(o, "utf-8", "surrogatepass");
+  if (!b) return 0;
+  PyBytes_AsStringAndSize(b, &q, &n);
+  Str *s = pys_str(q, n); Py_DecRef(b); return s;
+}
+static PyObject *args_of(Exc *e) {     /* e.args, rebuilt from repr(e) "Kind(a, b)" by ast.literal_eval, or (str(e),) */
+  Str *r = pys_exc_repr(e), *k = pys_exc_name(e);
+  PyObject *a = 0;
+  if (r->len >= k->len + 2 && r->s[k->len] == '(' && r->s[r->len - 1] == ')') {
+    I n = r->len - k->len - 2;
+    char *b = malloc(n + 4);
+    if (!b) return 0;
+    b[0] = '('; memcpy(b + 1, r->s + k->len + 1, n); memcpy(b + 1 + n, n ? ",)" : ")", 3);
+    PyObject *ast = PyImport_ImportModule("ast"), *f = ast ? PyObject_GetAttrString(ast, "literal_eval") : 0;
+    PyObject *t = f ? PyUnicode_DecodeUTF8(b, (Py_ssize_t)strlen(b), "surrogatepass") : 0;
+    a = t ? PyObject_Vectorcall(f, &t, 1, 0) : 0;
+    free(b); Py_DecRef(t); Py_DecRef(f); Py_DecRef(ast);
+    if (!a) PyErr_Clear();
+  }
+  if (!a) {                            /* (str(e),) */
+    PyObject *m = text(pys_exc_str(e));
+    if (m && (a = PyTuple_New(1))) PyTuple_SetItem(a, 0, m); else Py_DecRef(m);   /* (steals m) */
+  }
+  return a;
+}
+static PyObject *raised(Exc *e) {      /* a Pystachy exception, as the builtin class of its name (a class of the
+                                          program's: its nearest builtin base), with its args */
+  Str *k = pys_exc_name(e);
+  const char *b = k->s;
+  for (int i = 0; pyx_excbase[i].name; i++) if (!strcmp(pyx_excbase[i].name, k->s)) { b = pyx_excbase[i].base; break; }
+  PyObject *c = PyObject_GetAttrString(builtins, b), *a;
+  if (!c || PyObject_IsSubclass(c, PyExc_BaseException) != 1) {   /* (none: RuntimeError("Name: msg")) */
+    PyErr_Clear(); Py_DecRef(c); PyObject *m = text(pys_exc_str(e));
+    PyErr_Format(PyExc_RuntimeError, "%s: %U", k->s, m); Py_DecRef(m); return 0;
+  }
+  if ((a = args_of(e))) PyErr_SetObject(c, a);   /* (a tuple: the class is called with it as args) */
+  Py_DecRef(a); Py_DecRef(c); return 0;
+}
+/* each export's PyMethodDef calls its own @pyx.m.<name> (Gen.pyext), whose self is the module (so
+   that pickle finds the function by name), and that calls this with the export's index */
+__attribute__((noinline)) PyObject *pyx_call(I idx, PyObject *const *args, Py_ssize_t nargs, PyObject *kwnames) {
+  const Export *x = &pyx_exports[idx];
+  Py_ssize_t np = (Py_ssize_t)strlen(x->sig) - 1;
+  I a[np > 0 ? np : 1], r; Exc *err = 0; PyObject *res = 0; double d;
+  if (PyThread_get_thread_ident() != owner)
+    return PyErr_Format(PyExc_RuntimeError, "%s() is compiled by Pystachy, whose runtime is single-threaded: call it from the thread that imported its module", x->name);
+  if (printing) return PyErr_Format(PyExc_RuntimeError, "%s() called from sys.stdout.write while its module prints", x->name);
+  if (kwnames && PyTuple_Size(kwnames) > 0) return PyErr_Format(PyExc_TypeError, "%s() takes no keyword arguments", x->name);
+  if (nargs != np) return PyErr_Format(PyExc_TypeError, "%s() takes %d positional arguments but %d were given", x->name, (int)np, (int)nargs);
+  pys_enter(__builtin_frame_address(0));   /* (to_str allocates: this frame is scanned) */
+  for (Py_ssize_t i = 0; i < np; i++) {
+    PyObject *o = args[i];
+    switch (x->sig[i + 1]) {
+    case 'i': a[i] = PyLong_AsLongLong(o); if (a[i] == -1 && PyErr_Occurred()) goto out; break;
+    case 'f': d = PyFloat_AsDouble(o); if (d == -1.0 && PyErr_Occurred()) goto out; memcpy(&a[i], &d, 8); break;
+    case 'b': if (o != TRUE && o != FALSE) { PyErr_Format(PyExc_TypeError, "%s() argument %d must be bool", x->name, (int)i + 1); goto out; }
+              a[i] = o == TRUE; break;
+    default: if (!(a[i] = (I)to_str(o))) goto out;
+    }
+  }
+  r = x->fn(a, &err);
+  if (err) { res = raised(err); goto out; }
+  switch (x->sig[0]) {
+  case 'i': res = PyLong_FromLongLong(r); break;
+  case 'f': memcpy(&d, &r, 8); res = PyFloat_FromDouble(d); break;
+  case 'b': res = PyBool_FromLong((long)r); break;
+  case 's': res = text((Str *)r); break;
+  default: Py_IncRef(NONE); res = NONE;
+  }
+out:
+  pys_leave();
+  return res;
+}
+static const char *const known[] = {"KeyError", "IndexError", "ZeroDivisionError", "OverflowError", "ValueError",
+  "TypeError", "AttributeError", "ModuleNotFoundError", "ImportError", "NotImplementedError", "RecursionError",
+  "RuntimeError", "FileNotFoundError", "OSError", "StopIteration", "AssertionError", "LookupError",
+  "ArithmeticError", "KeyboardInterrupt", "Exception", 0};
+static _Noreturn void py_fail(void) {  /* the Python exception just raised, raised in the program as lib/pyobj.py
+                                          raises it: the first class in its __mro__ that Pystachy has, with str(e) */
+  PyObject *e = PyErr_GetRaisedException(), *t = e ? PyObject_Type(e) : 0, *mro = t ? PyObject_GetAttrString(t, "__mro__") : 0;
+  const char *k = 0;
+  for (Py_ssize_t i = 0, n = mro ? PyTuple_Size(mro) : 0; i < n && !k; i++) {
+    PyObject *nm = PyObject_GetAttrString(PyTuple_GetItem(mro, i), "__name__");   /* (borrowed item) */
+    const char *c = nm ? PyUnicode_AsUTF8AndSize(nm, 0) : 0;
+    for (int j = 0; c && known[j] && !k; j++) if (!strcmp(c, known[j])) k = known[j];
+    Py_DecRef(nm);
+  }
+  if (!k) k = "Exception";
+  if (!strcmp(k, "RecursionError")) k = "RuntimeError";
+  PyObject *m = e ? PyObject_Str(e) : 0;
+  Str *ms = m ? to_str(m) : 0;
+  PyErr_Clear(); Py_DecRef(m); Py_DecRef(mro); Py_DecRef(t); Py_DecRef(e);
+  pys_raise(pys_str(k, (I)strlen(k)), ms ? ms : pys_str("", 0));
+}
+static void out_hook(const char *s, I n, I fd) {   /* print() and sys.stdout: Python's sys.stdout, in order */
+  PyObject *f = PySys_GetObject(fd == 2 ? "stderr" : "stdout"), *u = PyUnicode_DecodeUTF8(s, n, "surrogatepass");   /* (f borrowed) */
+  PyObject *v[2] = {f, u};
+  printing++;
+  PyObject *r = f && u ? PyObject_VectorcallMethod(s_write, v, 2 | VC_OFFSET, 0) : 0;
+  printing--;
+  Py_DecRef(u);
+  if (!r) {                            /* the write raised (a closed file, a broken pipe): print raises it */
+    if (!f && !PyErr_Occurred()) PyErr_SetString(PyExc_RuntimeError, fd == 2 ? "lost sys.stderr" : "lost sys.stdout");
+    py_fail();
+  }
+  Py_DecRef(r);
+}
+void pyx_argv(void) {                  /* sys.argv: the host's, as the module's source sees it (at import) */
+  PyObject *av = PySys_GetObject("argv");   /* (borrowed) */
+  for (Py_ssize_t i = 0, n = av ? PyList_Size(av) : 0; i < n; i++) {
+    PyObject *o = PyList_GetItem(av, i), *so = o ? PyObject_Str(o) : 0;   /* (o borrowed) */
+    Str *s = so ? to_str(so) : 0;
+    Py_DecRef(so);
+    if (s) pys_list_append(pys_argv(), (I)s);
+  }
+  PyErr_Clear();
+}
+static PyMethodDef *defs;
+static int execed;
+static int exec_mod(PyObject *m) {
+  I n = 0; Exc *e;
+  if (execed) { PyErr_SetString(PyExc_ImportError, "a Pystachy extension module runs its code once per process: it cannot be imported again"); return -1; }
+  owner = PyThread_get_thread_ident();
+  if (!(builtins = PyImport_ImportModule("builtins")) || !(sys = PyImport_ImportModule("sys")) || !(s_write = PyUnicode_FromString("write"))) return -1;
+#ifdef PYX_ABI3T
+  {                                    /* Py_mod_gil = USED turned the GIL on, unless PYTHON_GIL=0 / -X gil=0 forces it off */
+    PyObject *f = PyObject_GetAttrString(sys, "_is_gil_enabled"), *on = f ? PyObject_Vectorcall(f, 0, 0, 0) : 0;
+    Py_DecRef(f); Py_DecRef(on);
+    if (!on) return -1;
+    if (on == FALSE) { PyErr_SetString(PyExc_ImportError, "a Pystachy extension module needs the GIL (its runtime is single-threaded), which PYTHON_GIL=0 or -X gil=0 keeps off"); return -1; }
+  }
+#endif
+  pys_set_out_hook(out_hook);
+  pys_enter(__builtin_frame_address(0));
+  e = pyx_init();                      /* the runtime, then the module's code */
+  if (e) { raised(e); pys_leave(); return -1; }
+  pys_leave();
+  while (pyx_exports[n].name) n++;
+  if (!(defs = calloc(n + 1, sizeof *defs))) return -1;
+  PyObject *mn = PyModule_GetNameObject(m);
+  for (I i = 0; i < n; i++) {
+    defs[i] = (PyMethodDef){pyx_exports[i].name, pyx_exports[i].meth, 0x80 | 0x02 /* METH_FASTCALL | METH_KEYWORDS */, 0};
+    PyObject *f = PyCFunction_NewEx(&defs[i], m, mn);   /* (self: the module, as PyModule_AddFunctions makes it) */
+    int bad = !f || PyModule_AddObjectRef(m, pyx_exports[i].name, f) < 0;
+    Py_DecRef(f);
+    if (bad) { Py_DecRef(mn); return -1; }
+  }
+  Py_DecRef(mn);
+  execed = 1;                          /* (an import that failed may be tried again: CPython runs the code again) */
+  return 0;
+}
+#ifdef PYX_ABI3T
+typedef struct { uint16_t id, flags; uint32_t reserved; void *p; } PySlot;
+typedef struct { uint8_t major, minor; uint16_t flags; uint32_t build_version, abi_version; } PyABIInfo;
+static PyABIInfo abi = {1, 0, 1 | 2 | 4 /* STABLE | GIL | FREETHREADED */, 0 /* built without CPython's headers */, 0x030F0000};
+static PySlot slots[] = {
+  {109 /* Py_mod_abi */, 2 /* PySlot_STATIC */, 0, &abi},
+  {100 /* Py_mod_name */, 2, 0, 0},
+  {85 /* Py_mod_exec */, 0, 0, (void *)exec_mod},
+  {87 /* Py_mod_gil */, 4 /* PySlot_INTPTR */, 0, 0 /* Py_MOD_GIL_USED: the runtime is single-threaded */},
+  {86 /* Py_mod_multiple_interpreters */, 4, 0, 0 /* NOT_SUPPORTED: one runtime per process */},
+  {0, 0, 0, 0}};
+PySlot *pyx_slots(const char *name) { slots[1].p = (void *)name; return slots; }
+#else
+typedef struct { Py_ssize_t refcnt; void *type, *init; Py_ssize_t index; void *copy; } PyModuleDef_Base;
+typedef struct { int slot; void *value; } PyModuleDef_Slot;
+typedef struct { PyModuleDef_Base base; const char *name, *doc; Py_ssize_t size; PyMethodDef *methods;
+                 PyModuleDef_Slot *slots; void *traverse, *clear, *free; } PyModuleDef;
+PyObject *PyModuleDef_Init(PyModuleDef *);
+static PyModuleDef_Slot slots[] = {{2 /* Py_mod_exec */, exec_mod},
+  {3 /* Py_mod_multiple_interpreters */, 0 /* NOT_SUPPORTED: one runtime per process */}, {0, 0}};
+static PyModuleDef def = {{1, 0, 0, 0, 0}, 0, 0, 0, 0, slots, 0, 0, 0};
+PyObject *pyx_module(const char *name) {
+  /* free-threaded 3.13 and 3.14 still load an .abi3.so and call this, though its PyModuleDef has the
+     GIL build's object header: refuse before CPython reads it (3.15t never loads .abi3.so) */
+  PyObject *fl = PySys_GetObject("abiflags");   /* (borrowed) */
+  const char *f = fl ? PyUnicode_AsUTF8AndSize(fl, 0) : 0;
+  if (f && strchr(f, 't')) {
+    PyErr_Format(PyExc_ImportError, "%s.abi3.so is built for CPython's GIL builds (abi3): on a free-threaded build, use the abi3t module (CPython 3.15+) or the source", name);
+    return 0;
+  }
+  PyErr_Clear();
+  def.name = name; return PyModuleDef_Init(&def);
+}
+#endif
diff --git atools/rt_cpython/ffi.py btools/rt_cpython/ffi.py
new file mode 100644
index 0000000..4b65894
--- /dev/null
+++ btools/rt_cpython/ffi.py
@@ -0,0 +1,189 @@
+"""CPython's version of Pystachy's ffi module, so that a program that declares C functions with
+@extern runs under CPython too (put this directory on PYTHONPATH): ctypes calls the same C
+function, with the checks Pystachy's stubs make. A str goes in as its UTF-8 bytes (const char *,
+NUL-terminated; a NUL in it is a ValueError) and a returned char * comes back as a str (NULL:
+None, or a ValueError for -> str); C integers are range-checked (OverflowError), as Pystachy
+checks them."""
+import ctypes
+import typing
+
+
+class c_int(int):
+    """C's int (32 bits) in an @extern function's signature; an int everywhere else"""
+
+
+class c_uint(int):
+    """C's unsigned int"""
+
+
+class c_int64(int):
+    """int64_t (long long)"""
+
+
+class c_ssize_t(int):
+    """ssize_t / Py_ssize_t"""
+
+
+class c_uint64(int):
+    """uint64_t"""
+
+
+class c_size_t(int):
+    """size_t"""
+
+
+class c_buf(str):
+    """a str's UTF-8 bytes (NULs allowed) for a C function that also takes their length"""
+
+
+class c_void_p(int):
+    """a pointer, as an int (NULL is 0)"""
+
+
+_C = {c_int: ctypes.c_int, c_uint: ctypes.c_uint, c_int64: ctypes.c_int64, c_ssize_t: ctypes.c_ssize_t,
+      c_uint64: ctypes.c_uint64, c_size_t: ctypes.c_size_t, c_void_p: ctypes.c_void_p,
+      c_buf: ctypes.c_char_p, float: ctypes.c_double, str: ctypes.c_char_p, type(None): None, typing.Optional[str]: ctypes.c_char_p}
+
+
+def _check(t, v):
+    if t is str:
+        if "\0" in v:
+            raise ValueError("embedded null character")
+        return v.encode("utf-8", "surrogatepass")
+    if t is c_buf:
+        return v.encode("utf-8", "surrogatepass")
+    if t is float:
+        return float(v)
+    if t is c_int and not -2**31 <= v < 2**31:
+        raise OverflowError("Python int too large to convert to C int")
+    if t in (c_uint, c_uint64, c_size_t) and v < 0:
+        raise OverflowError("can't convert negative int to unsigned")
+    if t is c_uint and v >= 2**32:
+        raise OverflowError("Python int too large to convert to C unsigned int")
+    if t in (c_int64, c_ssize_t, c_uint64, c_size_t, c_void_p) and not -2**63 <= v < 2**63:
+        raise OverflowError("int too big to convert")  # (Pystachy's int is 64-bit: checked where it was made)
+    return v
+
+
+def _s(b):
+    return None if b is None else b.decode("utf-8", "surrogatepass")
+
+
+def extern(lib, symbol=""):
+    def deco(f):
+        hints = typing.get_type_hints(f)
+        ret = hints.pop("return")
+        ts = list(hints.values())
+        for t in ts + [ret]:
+            if t is int:
+                raise TypeError(f"C function {f.__name__}() takes or returns int: say which C integer type")
+        cf = getattr(ctypes.CDLL(lib or None), symbol or f.__name__)
+        cf.argtypes = [_C[t] for t in ts]
+        cf.restype = _C[ret]
+
+        def call(*args):
+            r = cf(*[_check(t, a) for t, a in zip(ts, args)])
+            if ret is str and r is None:
+                raise ValueError("a C function declared -> str returned NULL")
+            if ret is c_void_p:
+                return r or 0  # (ctypes gives None for NULL)
+            if ret in (c_uint64, c_size_t) and r >= 2**63:
+                raise OverflowError("C unsigned result is too large for int")
+            return _s(r) if ret in (str, typing.Optional[str]) else r
+
+        call.__name__ = f.__name__
+        return call
+
+    return deco
+
+
+def string_at(addr, n):
+    if n < 0:
+        raise ValueError("ffi.string_at() takes a length >= 0")  # (ctypes reads up to a NUL)
+    return _s(ctypes.string_at(addr, n))
+
+
+# ffi.track, untrack, collected: Pystachy's collector reports the objects a program dropped (for
+# lib/pyobj.py, which releases their Python references); CPython releases them itself
+def track(owner, value):
+    return 0
+
+
+def untrack(i):
+    pass
+
+
+def collected():
+    return 0
+
+
+# @export: a function of a module that `pystachy ext` compiles into a CPython extension module.
+# Under CPython the module's source runs, and this wrapper makes each call what pyext.c's
+# trampoline makes it: positional arguments only, converted and checked as the extension
+# converts them, results checked against Pystachy's 64-bit int, only the importing thread may
+# call, and an exception leaves as the builtin class Pystachy raises it as (its nearest builtin
+# base for one of the module's own classes) with args rebuilt from their repr, else (str(e),).
+import ast as _ast
+import functools as _functools
+import operator as _operator
+import threading as _threading
+
+
+def _in(name, i, t, x):
+    if t is int:
+        v = _operator.index(x)
+        if not -2**63 <= v < 2**63:
+            raise OverflowError("int too big to convert")
+        return v
+    if t is float:
+        if not (hasattr(type(x), "__float__") or hasattr(type(x), "__index__")):
+            raise TypeError(f"must be real number, not {type(x).__name__}")
+        return float(x)
+    if t is bool:
+        if x is not True and x is not False:
+            raise TypeError(f"{name}() argument {i + 1} must be bool")
+        return x
+    if not isinstance(x, str):
+        raise TypeError("expected str")
+    return x[:]  # (a plain str)
+
+
+def _out(t, r):
+    if t is int and not -2**63 <= r < 2**63:
+        raise OverflowError("integer result does not fit in 64 bits")
+    return float(r) if t is float else r
+
+
+def export(f):
+    hints = _typing_hints(f)
+    ret = hints.pop("return")
+    ts = list(hints.values())
+    owner = _threading.get_ident()
+    name = f.__name__
+
+    @_functools.wraps(f)
+    def call(*args, **kw):
+        if _threading.get_ident() != owner:
+            raise RuntimeError(f"{name}() is compiled by Pystachy, whose runtime is single-threaded: call it from the thread that imported its module")
+        if kw:
+            raise TypeError(f"{name}() takes no keyword arguments")
+        if len(args) != len(ts):
+            raise TypeError(f"{name}() takes {len(ts)} positional arguments but {len(args)} were given")
+        a = [_in(name, i, t, x) for i, (t, x) in enumerate(zip(ts, args))]
+        try:
+            return _out(ret, f(*a))
+        except BaseException as e:
+            c = type(e)
+            if c.__module__ != "builtins":
+                c = next(k for k in c.__mro__ if k.__module__ == "builtins")
+            try:
+                ea = _ast.literal_eval(repr(e.args))
+            except Exception:
+                ea = (str(e),)
+            raise c(*ea) from None
+
+    return call
+
+
+def _typing_hints(f):
+    return typing.get_type_hints(f)

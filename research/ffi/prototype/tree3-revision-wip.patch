+"""CPython's version of Pystachy's lib/pyobj.py: the same API over the running interpreter's own
+objects (put this directory on PYTHONPATH). A Python exception is raised again as the first
+builtin class in its __mro__ that Pystachy has, with the same str(), as lib/pyobj.py does."""
+import builtins
+import importlib
+import operator
+import sys
+
+BUILTIN = ["KeyError", "IndexError", "ZeroDivisionError", "OverflowError", "ValueError", "TypeError",
+           "AttributeError", "ModuleNotFoundError", "ImportError", "NotImplementedError", "RecursionError",
+           "RuntimeError", "FileNotFoundError", "OSError", "StopIteration", "AssertionError", "LookupError",
+           "ArithmeticError", "KeyboardInterrupt", "SystemExit", "Exception"]
+
+
+_CLOSED = object()
+
+
+def _live(o):
+    if o is _CLOSED:
+        raise ValueError("operation on a closed Python object")
+    return o
+
+
+def _guard(f, *a):
+    try:
+        return f(*a)
+    except (SystemExit, KeyboardInterrupt):
+        raise
+    except BaseException as e:
+        k = next((c.__name__ for c in type(e).__mro__ if c.__name__ in BUILTIN), "Exception")
+        k = "RuntimeError" if k == "RecursionError" else k
+        raise getattr(builtins, k)(str(e)) from None
+
+
+class Object:
+    def __init__(self, o):
+        self.o = o
+
+    def close(self):
+        self.o = _CLOSED
+
+    def attr(self, name):
+        return Object(_guard(getattr, _live(self.o), name))
+
+    def call(self, args):
+        f, a = _live(self.o), [_live(x.o) for x in args]
+        sys.stdout.flush()
+        return Object(_guard(f, *a))
+
+    def __getitem__(self, k):
+        o, i = _live(self.o), _live(k.o)
+        return Object(_guard(lambda: o[i]))
+
+    def __len__(self):
+        return _guard(len, _live(self.o))
+
+    def __bool__(self):
+        return _guard(bool, _live(self.o))
+
+    def to_int(self):
+        return _guard(operator.index, _live(self.o))
+
+    def to_float(self):
+        return _guard(float, _live(self.o))
+
+    def __str__(self):
+        return _guard(str, _live(self.o))
+
+    def __repr__(self):
+        return _guard(repr, _live(self.o))
+
+
+def import_module(name):
+    return Object(_guard(importlib.import_module, name))
+
+
+def of_int(v):
+    return Object(v)
+
+
+def of_float(x):
+    return Object(x)
+
+
+def of_str(s):
+    return Object(s)
+
+
+def of_list(xs):
+    return Object([_live(x.o) for x in xs])

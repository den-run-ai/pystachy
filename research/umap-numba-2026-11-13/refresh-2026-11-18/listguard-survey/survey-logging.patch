+def lg_reason(self, fn, lp, why):
+    import os
+    path = os.environ.get("LGSURVEY", "")
+    if path != "":
+        at = {}
+        for j in range(len(fn.blocks)):
+            at[fn.blocks[j].label] = j
+        region = {lp.head: True}
+        pending = [lp.body]
+        acc = 0
+        idxacc = 0
+        while len(pending) > 0:
+            l = pending.pop()
+            if l in region or l == lp.exit or l not in at:
+                continue
+            region[l] = True
+            b = fn.blocks[at[l]]
+            for i in b.code:
+                if i.op == "rt" and (i.s == "list.get" or i.s == "list.set"):
+                    acc += 1
+            for x in b.code[len(b.code) - 1].b:
+                pending.append(x)
+        with open(path, "a") as f:
+            f.write(f"{fn.f.ll}\t{lp.kind}\t{lp.nonnegative}\tacc={acc}\t{why}\n")
+    return None

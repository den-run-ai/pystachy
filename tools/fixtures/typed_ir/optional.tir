; Reads of opt[U] values at U, which the verifier admits only where the closed-union proof shows
; them not None (ircheck.optional_reads, UnionProof.check_some). Each function without an
; expected error verifies; tools/test_typed_ir_text.py removes their tests to see them fail.

module version=1 {
  class Node tag=1 fields=[" class":int name:opt[str]]
  class Other tag=2 fields=[" class":int label:opt[str]]
  class Holder tag=3 fields=[" class":int node:Node]
}

function @a_read_without_a_test(s: opt[str]) -> int {
entry:
  ; expected-error {{rt operand 0 reads %a0 as str without a proof that it is not None}}
  %t1 = rt entry=text.len (str %a0) : int
  ret(int %t1)
}

function @a_read_after_a_test(s: opt[str]) -> int {
entry:
  %t1 = ptr.cmp == (opt[str] %a0, None null) : bool
  cbr(bool %t1) -> L2, L3
L2:
  ret(int 0)
L3:
  %t4 = rt entry=text.len (str %a0) : int
  ret(int %t4)
}

function @a_read_of_the_tested_value_on_its_none_edge(s: opt[str]) -> int {
entry:
  %t1 = ptr.cmp != (opt[str] %a0, None null) : bool
  cbr(bool %t1) -> L2, L3
L2:
  ret(int 0)
L3:
  ; expected-error {{rt operand 0 reads %a0 as str without a proof that it is not None}}
  %t4 = rt entry=text.len (str %a0) : int
  ret(int %t4)
}

function @a_reload_after_a_test(s: opt[str]) -> int {
  %s.1 = slot name=s : opt[str]
entry:
  mem.store(&opt[str] %s.1, opt[str] %a0)
  %t2 = mem.load(&opt[str] %s.1) : opt[str]
  %t3 = ptr.cmp == (opt[str] %t2, None null) : bool
  cbr(bool %t3) -> L4, L5
L4:
  ret(int 0)
L5:
  %t6 = mem.load(&opt[str] %s.1) : opt[str]
  %t7 = rt entry=text.len (str %t6) : int
  ret(int %t7)
}

function @a_reload_after_a_store(s: opt[str], t: opt[str]) -> int {
  %s.1 = slot name=s : opt[str]
entry:
  mem.store(&opt[str] %s.1, opt[str] %a0)
  %t2 = mem.load(&opt[str] %s.1) : opt[str]
  %t3 = ptr.cmp == (opt[str] %t2, None null) : bool
  cbr(bool %t3) -> L4, L5
L4:
  ret(int 0)
L5:
  mem.store(&opt[str] %s.1, opt[str] %a1)
  %t6 = mem.load(&opt[str] %s.1) : opt[str]
  ; expected-error {{rt operand 0 reads %t6 as str without a proof that it is not None}}
  %t7 = rt entry=text.len (str %t6) : int
  ret(int %t7)
}

function @a_reload_of_a_stored_str(s: str) -> int {
  %s.1 = slot name=s : opt[str]
entry:
  mem.store(&opt[str] %s.1, opt[str] %a0)
  %t2 = mem.load(&opt[str] %s.1) : opt[str]
  %t3 = rt entry=text.len (str %t2) : int

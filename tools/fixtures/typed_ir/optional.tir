  %t4 = rt entry=text.len (str %t22) : int
  %t5 = num.cmp > (int %t4, int 0) : bool
  br -> L3
L3:
  %t6 = phi(bool %t1, bool %t5) -> entry, L2 : bool
  cbr(bool %t6) -> L7, L8
L7:
  %t23 = mem.load(&opt[str] %s.20) : opt[str]

function @a_read_after_a_short_circuit_test(s: opt[str]) -> int {
entry:
  %t1 = ptr.cmp != (opt[str] %a0, None null) : bool
  cbr(bool %t1) -> L2, L3
L2:
  %t4 = rt entry=text.len (str %a0) : int
  %t5 = num.cmp > (int %t4, int 0) : bool
  br -> L3
L3:
  %t6 = phi(bool %t1, bool %t5) -> entry, L2 : bool
  cbr(bool %t6) -> L7, L8
L7:
  %t9 = rt entry=text.len (str %a0) : int
  ret(int %t9)
L8:
  ret(int -1)
}

function @a_loop_that_tests_in_its_head(s: opt[str]) -> int {
  %s.1 = slot name=s : opt[str]
  %n.2 = slot name=n : int
entry:
  mem.store(&opt[str] %s.1, opt[str] %a0)
  mem.store(&int %n.2, int 0)
  br -> L3
L3:
  %t4 = mem.load(&opt[str] %s.1) : opt[str]
  %t5 = ptr.cmp != (opt[str] %t4, None null) : bool
  cbr(bool %t5) -> L6, L7
L6:
  %t8 = mem.load(&opt[str] %s.1) : opt[str]
  %t9 = rt entry=text.len (str %t8) : int
  mem.store(&int %n.2, int %t9)
  mem.store(&opt[str] %s.1, opt[str] null)
  br -> L3
L7:
  %t10 = mem.load(&int %n.2) : int
  ret(int %t10)
}

function @a_phi_from_the_none_edge(s: opt[str]) -> str {
entry:
  %t1 = ptr.cmp == (opt[str] %a0, None null) : bool
  cbr(bool %t1) -> L2, L3
L2:
  br -> L4
L3:
  br -> L4
L4:
  ; expected-error {{phi operand from L2 reads %a0 as str without a proof that it is not None}}
  %t5 = phi(str %a0, str %a0) -> L2, L3 : str
  ret(str %t5)
}

function @a_phi_from_the_tested_edge(s: opt[str], t: str) -> str {
entry:
  %t1 = ptr.cmp == (opt[str] %a0, None null) : bool
  cbr(bool %t1) -> L2, L3
L2:
  br -> L3
L3:
  %t4 = phi(str %a1, str %a0) -> L2, entry : str
  ret(str %t4)
}


  %n.1 = slot name=n : Node
entry:
  mem.store(&Node %n.1, Node %a0)
  %t2 = mem.load(&Node %n.1) : Node
  %t3 = field.addr index=1 (Node %t2) : &opt[str]
  %t4 = mem.load(&opt[str] %t3) : opt[str]
  %t5 = ptr.cmp == (opt[str] %t4, None null) : bool
  cbr(bool %t5) -> L6, L7
L6:
  ret(int 0)
L7:
  %t8 = mem.load(&Node %n.1) : Node
  %t9 = field.addr index=1 (Node %t8) : &opt[str]
  %t10 = mem.load(&opt[str] %t9) : opt[str]
  %t11 = rt entry=text.len (str %t10) : int
  ret(int %t11)
}

